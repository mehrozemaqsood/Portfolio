---
// Figma "Bg Lines": vertical 2% stripes. dir "rl": white at left edge -> black at right (stripes laid from the right edge).
const { top = 0, h = 884, w = 65.4545, cls = '', sw = 1440 } = Astro.props;
const wi = `${w}px`;
---
<div aria-hidden="true" data-bgl class={`pointer-events-none absolute left-0 overflow-clip ${cls}`} style={`width:${sw}px;top:${top}px;height:${h}px;z-index:-1`}>
  <div class="absolute bottom-0 right-0 top-0" style={`width:${wi};background:rgba(255,255,255,.02)`}></div>
  <div class="absolute bottom-0 left-0 top-0" style={`right:${wi};background-image:repeating-linear-gradient(270deg, rgba(0,0,0,.02) 0, rgba(255,255,255,.02) ${wi})`}></div>
</div>
