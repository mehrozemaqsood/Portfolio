---
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
import BgLines from './BgLines.astro';
import BrowserMock from './BrowserMock.astro';

const meta = [['ROLE', 'UI/UX Designer'], ['TIMELINE', 'Redesign Project'], ['TOOLS', 'Figma'], ['CLIENT', 'LensesOnline (NZ)']];
const stats = [['19', 'Desktop pages', 'Every core shopping page'], ['19', 'Mobile pages', 'A layout for each page'], ['13', 'Components', 'Cards, navigation, buttons'], ['13', 'Overlay screens', 'Login, cart slider, pop-up'], ['2', 'Breakpoints', 'Desktop and mobile']];
const goals = [['01', 'Build trust early', 'Delivery, guarantee and reviews sit in the layout itself, so the shopper is reassured before they are asked for anything.'], ['02', 'Make prescriptions easy', 'The most demanding step of buying lenses becomes a clear, guided form instead of a wall of dropdowns.'], ['03', 'Speed up reorders', 'Accounts, subscriptions and a cart slider keep repeat purchases to a few taps.']];
const brief = [['The brief', 'Redesign the LensesOnline storefront end to end, keeping the products and the shopping journey but replacing the interface and its patterns.'], ['My role', 'UI/UX designer. I audited the old site, defined the page structure, designed every screen, built the component library and drew the mobile layouts.'], ['Scope', 'Home, category, product, cart, checkout, account, calculator, help, blog, reviews and more: 18+ page types in Figma.']];
const before = [
  ['Home', 'BEFORE  /  HOME', 110, 'LensesOnli_269-1534', 'h-full left-0 top-0 w-[100.77%]', 'Three stacked strips before any content', 'A promo bar, a header and a rating strip come before the hero, and the hero itself is a rotating slider of photos that say little about the brand.'],
  ['Product cards', 'BEFORE  /  PRODUCT CARDS', 172, 'LensesOnli_269-1536', 'h-[198.66%] left-[-62.58%] top-[-68.36%] w-[200.26%]', 'Uneven cards, repeated buttons', 'Product images come in different sizes and the same "Enter Prescription" button repeats on every card, so nothing stands out.'],
  ['Category', 'BEFORE  /  CATEGORY', 137, 'LensesOnli_269-1536', 'h-[155.67%] left-[-30%] top-[-17.23%] w-[156.8%]', 'A text list instead of filters', 'Browsing relied on a long sidebar of plain text links, with no visual way to narrow down by brand, type or price.'],
  ['Product form', 'BEFORE  /  PRODUCT FORM', 166, 'LensesOnli_269-1540', 'h-[155.67%] left-[-30%] top-[-55.67%] w-[156.8%]', 'Six dropdowns and a quantity of 0', 'The prescription form opens as six "Choose Options" dropdowns with a quantity of 0 for each eye, so nothing is pre-filled.'],
];
const principles = [['01', 'Trust is part of the layout', 'Delivery, guarantee and review signals are placed where doubt appears, not hidden in the footer.'], ['02', 'Prescription first', 'Lenses are useless without the right prescription, so that step gets the clearest, calmest form.'], ['03', 'Calm, consistent components', 'One button, card and nav system replaces one-off styles, so pages feel related.'], ['04', 'One system, two breakpoints', 'Every desktop page has a mobile layout built from the same components.']];
const chunks = [['LensesOnli_240-12088', 572], ['LensesOnli_240-12089', 56], ['LensesOnli_240-12090', 269], ['LensesOnli_255-22551', 521], ['LensesOnli_255-22552', 538.025], ['LensesOnli_255-22553', 710], ['LensesOnli_255-22554', 567], ['LensesOnli_255-22555', 766], ['LensesOnli_255-22556', 1099.097]];
const calc = [['01', 'Two eyes, one glance', 'Right and left eye sit side by side with SPH, CYL and AXIS labelled, so entry mirrors a real prescription.'], ['02', 'Result in the same shape', 'Results reuse the layout of the input in green-tinted cards, so the shopper compares like with like.'], ['03', 'Honest by design', 'A note says the result is an estimate to confirm with an eye-care professional, and a short guide explains each term.']];
const desk = [['Product detail', '2490'], ['Home', '3143'], ['Category', '3853'], ['Account', '4394'], ['Cart', '5101'], ['Checkout', '5874'], ['Contact', '6177'], ['Power calculator', '6553'], ['Shipping rates', '6873'], ['Blog', '7239'], ['Blog post', '7572'], ['Terms and privacy', '7907'], ['Reviews', '8294'], ['About', '8624'], ['Money-back guarantee', '9437'], ['Brand not listed', '9897'], ['Help', '10265'], ['Help article', '10596'], ['Subscription', '10948']];
const mob = [['Home', '11620'], ['Category', '12277'], ['Product', '12997'], ['Cart', '13693'], ['Checkout', '14449'], ['Contact', '14739'], ['Power calculator', '15099'], ['Shipping rates', '15414'], ['Blog', '15768'], ['Blog post', '16088'], ['Terms and privacy', '16375'], ['Reviews', '16741'], ['About', '17060'], ['Money-back guarantee', '17813'], ['Brand not listed', '18259'], ['Help', '18601'], ['Help article', '18916'], ['Subscription', '19257']];
const dLogin = [['Default', '1264', 277], ['Wrong password', '1300', 286], ['Email exists', '1339', 286], ['Forgot password', '1352', 145], ['Create account', '1395', 322]];
const mLogin = [['Default', '1434', 405], ['Wrong password', '1470', 417], ['Email exists', '1508', 417], ['Forgot password', '1521', 204], ['Create account', '1564', 454]];
const outcomes = [['01', 'Retail UX', 'Trust signals, prescription entry, filters, cart and checkout designed for a shopper who is careful about what goes in their eyes.'], ['02', 'Systems thinking', '13 components and shared patterns drive 19 desktop and 18 mobile pages, plus login, cart and pop-up states.'], ['03', 'Responsive design', 'Every page has a mobile layout with a pinned, compact navigation and the same components at phone scale.'], ['04', 'Attention to detail', 'Error states, an honest calculator disclaimer, hover-ready cards and consistent spacing throughout.']];
const pchunks = [['LensesOnli_240-12088', 346.118], ['LensesOnli_240-12089', 33.886], ['LensesOnli_240-12090', 162.772], ['LensesOnli_255-22551', 315.258], ['LensesOnli_255-22552', 325.559], ['LensesOnli_255-22553', 429.622], ['LensesOnli_255-22554', 343.092], ['LensesOnli_255-22555', 463.507], ['LensesOnli_255-22556', 665.065]];
const chips = ['Home', 'Category', 'Product', 'Cart'];

const sec = 'relative flex w-full flex-col items-start gap-[32px] px-[40px] py-[72px]';
const eyebrow = 'w-full whitespace-nowrap font-ral text-[14px] font-bold leading-[normal] tracking-[2px] text-[#0083f0]';
const title = 'w-full whitespace-nowrap font-ral text-[71.4px] font-semibold leading-[74.8px] tracking-[-2.125px] text-white';
const lead = 'w-full font-ral text-[27px] font-semibold leading-[36px] text-white';
const body = 'w-full font-ral text-[17px] font-normal leading-[28px] text-white';
const card = 'flex w-full shrink-0 flex-col items-start gap-[16px] rounded-[16px] border border-solid border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.04)] p-[32px]';
const num = 'h-[33px] w-full font-ral text-[28.8px] font-semibold leading-[32.4px] tracking-[-1.8px] text-[rgba(89,153,255,0.9)]';
const ct = 'h-[27px] w-full font-ral text-[19.8px] font-semibold leading-[27px] text-white';
const cd = 'w-full font-ral text-[16px] font-normal leading-[26px] text-[#9e9ea6]';
const sub = 'w-full font-ral text-[14px] font-bold leading-[normal] tracking-[2px] text-[#9e9ea6]';
const lab = 'w-full font-ral text-[14px] font-medium leading-[normal] text-white';
const thumb = 'relative w-full shrink-0 rounded-[10px] border border-solid border-[rgba(255,255,255,0.12)]';
const thumbImg = 'pointer-events-none absolute inset-0 size-full max-w-none rounded-[10px] object-cover';
const noBar = '[scrollbar-width:none] [&::-webkit-scrollbar]:hidden';
const lk = 'block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]';
const wall = 'flex w-full shrink-0 flex-wrap content-start items-start gap-x-[16px] gap-y-[24px]';
const frame = (w, h) => `relative shrink-0 rounded-[10px] border border-solid border-[rgba(255,255,255,0.12)]`;
const Hh = (n) => `height:${n}px`;
const ol = (arr) => arr;
---
<div class="relative h-[21586.9px] w-full overflow-clip bg-[#020202]">
  <section aria-label="LensesOnline hero art" class="absolute left-0 top-0 h-[596px] w-full overflow-clip" style="background-image:linear-gradient(2.28198deg, rgb(122, 145, 246) 28.782%, rgb(49, 71, 166) 54.697%, rgb(0, 0, 0) 90.241%)">
    <BgLines top={0} h={884} sw={768} w={34.9091} />
    <header class="absolute left-[40px] top-[28px] flex h-[43px] w-[688px] items-center justify-between">
      <div class="relative flex h-[22px] w-[140px] shrink-0 flex-col items-start pr-[99px]">
        <a href="/" aria-label="Home" class="absolute left-[-5.85px] top-0 flex h-[22px] w-[38.211px] items-center justify-center">
          <div class="flex-none -skew-x-[28deg] scale-y-[0.88]">
            <div class="relative flex cursor-pointer items-start gap-[4.257px]">
              <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></span>
              <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></span>
              <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></span>
            </div>
          </div>
        </a>
      </div>
      <nav class="flex shrink-0 items-center gap-[12px]">
        <a href="/boltshift" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">BoltShift</p></a>
        <a href="/lensesonline" aria-current="page" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-white whitespace-nowrap">LensesOnline</p></a>
        <a href="/stichting-sportpark" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Stichting</p></a>
        <a href="/zapier" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Zapier</p></a>
        <a href="/visual-design" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Visual Design</p></a>
      </nav>
      <div class="flex shrink-0 items-start justify-end gap-[12px]">
        <a href="/Mehroze_UIUX_CV.pdf" target="_blank" rel="noopener" class="flex h-[43px] shrink-0 items-center gap-[10px] rounded-[46px] border border-solid border-[#8499f8] px-[16px]">
        <p class="font-ral text-[14px] font-semibold leading-[16.5px] text-[#8499f8] whitespace-nowrap">View CV</p>
        <span class="relative block size-[16px] shrink-0"><Arrow /></span>
      </a>
      </div>
    </header>
    <p aria-hidden="true" class="absolute left-[384px] top-[105px] -translate-x-1/2 bg-clip-text font-utara text-[94.421px] font-semibold not-italic leading-[normal] tracking-[-0.6405px] text-[transparent] text-center whitespace-nowrap" style="background-image:linear-gradient(0.2141426803027855deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(172.04049320124147deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%);-webkit-background-clip:text;background-clip:text">E-COMMERCE</p>
    <div class="absolute left-0 top-[559.19px] h-[107.506px] w-[768px] rounded-tl-[27.96px] rounded-tr-[27.96px] bg-[#050505]"></div>
    <div class="absolute left-[89.13px] top-[502px] h-[85.991px] w-[590.062px]"><Img f="PortfolioH_124-1789" class="absolute inset-0 size-full max-w-none object-bottom" sizes="590px" eager /></div>
    <div class="absolute left-[89.26px] top-[165px] h-[422.995px] w-[500.795px]"><Img f="R2_124-1791" alt="LensesOnline homepage on a desktop monitor" class="absolute inset-0 size-full max-w-none" sizes="501px" eager /></div>
    <div class="absolute left-[378.58px] top-[199.62px] flex h-[11.151px] w-[20.187px] items-center justify-center">
      <div class="flex-none rotate-[1.01deg]"><div class="relative h-[10.8px] w-[19.999px]"><div class="pointer-events-none absolute inset-0 overflow-hidden"><Img f="PortfolioH_124-1792" class="absolute left-[-0.49%] top-[-7.41%] h-[107.41%] w-[100.99%] max-w-none" sizes="20px" /></div></div></div>
    </div>
    <div class="absolute left-[589.92px] top-[206.77px] flex h-[259.202px] w-[2.866px] items-center justify-center"><div class="h-[2.866px] w-[259.202px] flex-none -rotate-90 bg-gradient-to-l from-[#141611] to-[#020204]"></div></div>
    <div class="absolute left-[165.7px] top-[193.25px] flex h-[277.219px] w-[3.685px] items-center justify-center"><div class="h-[3.685px] w-[277.219px] flex-none -rotate-90 rounded-bl-[2.33px] rounded-tl-[2.33px] bg-gradient-to-l from-[#262528] to-[#020204]"></div></div>
    <div class="absolute left-[162.08px] top-[191.27px] flex h-[279.93px] w-[4.095px] items-center justify-center"><div class="h-[279.93px] w-[3.409px] flex-none rotate-[-0.14deg] rounded-bl-[1.166px] rounded-tl-[1.166px] bg-gradient-to-b from-[#414344] to-[#4a4b50]"></div></div>
  </section>

  <section aria-label="LensesOnline introduction" class="absolute left-0 top-[537px] flex h-[1038.7px] w-full flex-col items-start px-[40px] pb-[64px] pt-[56px]">
    <div class="h-[16px] w-px shrink-0"></div>
    <h1 class="h-[75px] w-full font-ral text-[74.8px] font-semibold leading-[74.8px] tracking-[-2.975px] text-white">LensesOnline</h1>
    <div class="h-[24px] w-px shrink-0"></div>
    <p class="h-[95px] w-full font-ral text-[19.8px] font-normal leading-[31.5px] tracking-[-0.36px] text-[#f5f5f5]">A full UI redesign of an online contact-lens retailer — rebuilding a dated, cluttered storefront into a clean, trustworthy shopping experience across 18+ page types.</p>
    <div class="h-[48px] w-px shrink-0"></div>
    <div class="flex w-full shrink-0 flex-wrap content-start items-start gap-x-[32px] gap-y-[28px] overflow-clip leading-[normal]">
      {meta.map(([k, v]) => (
        <div class="flex w-[328px] shrink-0 flex-col items-start gap-[8px] overflow-clip">
          <p class="w-full font-ral text-[21.6px] font-bold uppercase tracking-[1.17px] text-[#0083f0]">{k}</p>
          <p class="w-full font-ral text-[18px] font-medium text-white">{v}</p>
        </div>
      ))}
    </div>
    <div class="h-[56px] w-px shrink-0"></div>
    <BrowserMock s={0.5733333} eager />
  </section>

  <div class="absolute left-0 top-[1575.7px] w-full">
    <section aria-label="At a glance" class="flex w-full flex-wrap content-start items-start gap-[32px] bg-[#020202] p-[40px]">
      {stats.map(([n, t, d]) => (
        <div class="flex w-[208px] shrink-0 flex-col items-start gap-[8px] overflow-clip">
          <p class="h-[58px] w-full font-ral text-[54.4px] font-semibold leading-[57.8px] tracking-[-1.7px] text-white">{n}</p>
          <p class="w-full font-ral text-[18px] font-semibold leading-[normal] text-white">{t}</p>
          <p class="w-full font-ral text-[14px] font-normal leading-[normal] text-[#9e9ea6]">{d}</p>
        </div>
      ))}
    </section>

    <section id="overview-t" aria-label="Overview" class={sec} style="background-image:linear-gradient(12.669252666600315deg, rgb(0, 0, 0) 37.573%, rgb(122, 145, 246) 51.604%, rgb(49, 71, 166) 64.714%, rgb(0, 0, 0) 89.063%), linear-gradient(90deg, rgb(2, 2, 2) 0%, rgb(2, 2, 2) 100%)">
      <p class={eyebrow}>{'01  /  OVERVIEW'}</p>
      <h2 class={title}>OVERVIEW</h2>
      <p class={lead}>An online contact-lens shop should feel as calm and trustworthy as an optician, not like a clearance flyer.</p>
      <p class={body}>LensesOnline is a New Zealand contact-lens retailer. The existing storefront stacked promotional strips, uneven product cards and long text lists. I redesigned the whole experience as one UI system: 19 desktop pages and 18 mobile pages, built from 13 reusable components.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {goals.map(([n, t, d]) => (<div class={card}><p class={num}>{n}</p><h3 class={ct}>{t}</h3><p class={cd}>{d}</p></div>))}
      </div>
    </section>

    <section aria-label="Brief and role" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'02  /  BRIEF AND ROLE'}</p>
      <h2 class={title}>BRIEF AND ROLE</h2>
      <p class={lead}>The brief: make a dated, cluttered storefront feel modern and safe to buy from, on desktop and mobile.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {brief.map(([t, d]) => (<div class={card}><h3 class={ct}>{t}</h3><p class={cd}>{d}</p></div>))}
      </div>
      <p class="w-full font-ral text-[15px] font-normal leading-[24px] text-[#9e9ea6]">This is a design project. Screens use placeholder content where needed, and no live performance figures are claimed.</p>
    </section>

    <section aria-label="The starting point" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'03  /  THE STARTING POINT'}</p>
      <h2 class="h-[74px] w-full whitespace-nowrap font-ral text-[69.882px] font-semibold leading-[73.209px] tracking-[-2.0798px] text-white">THE STARTING POINT</h2>
      <p class={lead}>The old site worked, but almost every page asked the shopper to do extra work.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {before.map(([n, chip, cw, k, pos, t, d]) => (
          <div class="flex w-full shrink-0 flex-col items-start gap-[16px]">
            <div class="relative flex h-[280px] w-full shrink-0 flex-col items-center justify-center overflow-clip rounded-[16px] border border-dashed border-[rgba(255,255,255,0.25)] bg-[rgba(255,255,255,0.03)]">
              <div class="absolute left-[-1px] top-[-1px] h-[280px] w-[688px] rounded-[16px]"><div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[16px]"><Img f={k} alt={`Old site: ${n}`} class={`absolute max-w-none ${pos}`} sizes="688px" /></div></div>
              <div class="absolute left-[5px] top-[5px] h-[21px] rounded-[5px] bg-[rgba(2,2,2,0.88)]" style={`width:${cw}px`}></div>
              <p class="absolute left-[11px] top-[10px] font-ral text-[9px] font-bold leading-[normal] tracking-[1.5px] text-[#9e9ea6] whitespace-pre">{chip}</p>
            </div>
            <h3 class={ct}>{t}</h3>
            <p class={cd}>{d}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="principles-t" aria-label="Principles" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'04  /  PRINCIPLES'}</p>
      <h2 class={title}>PRINCIPLES</h2>
      <p class={lead}>Four rules kept every screen consistent, from the home page to the last checkout step.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {principles.map(([n, t, d]) => (<div class={card}><p class={num}>{n}</p><h3 class={ct}>{t}</h3><p class={cd}>{d}</p></div>))}
      </div>
    </section>

    <section id="mobile-t" aria-label="Mobile experience" class={sec} style="background-image:linear-gradient(9.468037509603448deg, rgb(0, 0, 0) 37.573%, rgb(122, 145, 246) 51.604%, rgb(49, 71, 166) 64.714%, rgb(0, 0, 0) 89.063%)">
      <BgLines top={2.5} h={1306} w={57.4762} />
      <p class={eyebrow}>{'05  /  MOBILE EXPERIENCE'}</p>
      <h2 class={title}>MOBILE EXPERIENCE</h2>
      <p class={lead}>The same system on a phone: scroll inside the device and switch pages with the chips.</p>
      <div class="flex w-[688px] shrink-0 items-center gap-[48.408px]">
        <div class="relative h-[486.501px] w-[252.327px] shrink-0 rounded-[56px] bg-[#15151a]">
          <div class="absolute left-[7.26px] top-[7.26px] h-[471.979px] w-[237.805px] overflow-clip rounded-[44px] bg-white">
            <div class={`lo-m-vp absolute left-0 top-0 h-[471.979px] w-[237.805px] overflow-y-auto overflow-x-clip bg-white ${noBar}`} tabindex="0" aria-label="LensesOnline home page on mobile, scrollable">
              {pchunks.map(([k, h]) => (<div class="relative bg-white" style={`width:237.805px;height:${h}px`}><Img f={k} alt="" class="absolute inset-0 size-full max-w-none object-cover" sizes="240px" /></div>))}
            </div>
            <div class="pointer-events-none absolute left-0 top-0 h-[49.618px] w-[237.805px]"><Img f="LensesOnli_240-12091" alt="" class="absolute inset-0 size-full max-w-none object-cover" sizes="240px" /></div>
          </div>
        </div>
        <div class="flex w-[387.265px] shrink-0 flex-col items-start gap-[14.522px]">
          <div class="flex items-start gap-[7.261px]">
            {chips.map((c, i) => (<span class={`flex items-start rounded-[999px] border-[0.605px] border-solid px-[12.102px] py-[6.051px] font-ral text-[9.08px] font-semibold leading-[normal] whitespace-nowrap ${i === 0 ? 'border-[rgba(255,255,255,0)] bg-[#0083f0] text-white' : 'border-[rgba(255,255,255,0.14)] bg-[rgba(255,255,255,0.06)] text-[rgba(255,255,255,0.9)]'}`}>{c}</span>))}
          </div>
          <p class="w-[387.265px] font-ral text-[26.62px] font-semibold leading-[30.255px] tracking-[-1px] text-white">Home</p>
          <p class="w-[338.857px] font-ral text-[10.89px] font-normal leading-[17.548px] text-[rgba(255,255,255,0.9)]">The hero, brand shortcuts, featured lenses and articles stack into one thumb-friendly column.</p>
          <p class="w-[338.857px] font-ral text-[8.47px] font-normal leading-[13.312px] text-[rgba(255,255,255,0.75)]">Scroll inside the phone. The navigation stays pinned, as it would on the live site.</p>
        </div>
      </div>
    </section>

    <section aria-label="Power calculator" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'06  /  A NEW TOOL'}</p>
      <h2 class="w-full whitespace-nowrap font-ral text-[68.637px] font-semibold leading-[71.905px] tracking-[-2.0428px] text-white">POWER CALCULATOR</h2>
      <p class={lead}>A small tool with a real job: turning a glasses prescription into a contact-lens power estimate.</p>
      <div class="relative h-[536.067px] w-[688px] shrink-0 rounded-[9.173px] border-[0.573px] border-solid border-[rgba(255,255,255,0.12)]"><Img f="LensesOnli_241-1666" alt="Contact lens power calculator with prescription guide" class="pointer-events-none absolute inset-0 size-full max-w-none rounded-[9.173px] object-cover" sizes="688px" /></div>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {calc.map(([n, t, d]) => (<div class={card}><p class={num}>{n}</p><h3 class={ct}>{t}</h3><p class={cd}>{d}</p></div>))}
      </div>
    </section>

    <section id="every-page-t" aria-label="Every page" class={sec} style="background-image:linear-gradient(31.131858755544677deg, rgb(0, 0, 0) 27.897%, rgb(122, 145, 246) 45.429%, rgb(49, 71, 166) 61.811%, rgb(0, 0, 0) 92.236%)">
      <BgLines top={1} h={2920} />
      <p class={eyebrow}>{'07  /  EVERY PAGE'}</p>
      <h2 class={title}>EVERY PAGE</h2>
