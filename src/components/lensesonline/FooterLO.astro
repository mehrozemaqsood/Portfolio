---
import BgLines from './BgLines.astro';
---
  <footer class="relative h-[601px] w-full overflow-clip" style="background-image:linear-gradient(11.955853866081299deg, rgb(122, 145, 246) 7.5389%, rgb(49, 71, 166) 29.332%, rgb(0, 0, 0) 59.221%)">
    <BgLines top={0} h={601} />
    <p class="absolute top-[77px] -translate-x-1/2 bg-clip-text font-utara text-[126px] font-semibold not-italic leading-[normal] tracking-[-1.16px] text-[transparent] text-center whitespace-nowrap" style="left:calc(50% + 0.5px);background-image:linear-gradient(0.16214002469791922deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(173.95684027926643deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%), linear-gradient(90deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100%);-webkit-background-clip:text;background-clip:text">Let’s build something!</p>
    <div class="absolute left-[120px] top-[296px] flex w-[1200px] items-center justify-between overflow-clip">
      <div class="flex shrink-0 flex-col items-start overflow-clip">
        <p class="w-[560px] font-ral text-[18px] font-normal leading-[30px] text-[rgba(255,255,255,0.75)]">Open to full-time UI/UX &amp; product design roles and select freelance projects. Send a brief and I'll get back to you.</p>
      </div>
      <div class="flex shrink-0 items-start gap-[40px] overflow-clip whitespace-nowrap">
        <div class="flex shrink-0 flex-col items-start gap-[14px] overflow-clip leading-[normal]">
          <p class="font-ral text-[12px] font-bold uppercase tracking-[2px] text-[#96a3f9]">Explore</p>
          <a href="/#about" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">About Me</a>
          <a href="/#work" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">Selected Works</a>
          <a href="/#services" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">What I Do</a>
          <a href="/#contact" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">Contact</a>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-[14px] overflow-clip leading-[normal]">
          <p class="font-ral text-[12px] font-bold uppercase tracking-[2px] text-[#96a3f9]">Connect</p>
          <a href="https://www.linkedin.com/in/muhammadmehrozemaqsood/" target="_blank" rel="noopener" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">LinkedIn</a>
          <a href="https://www.behance.net/mehrozemaqsood" target="_blank" rel="noopener" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">Behance</a>
          <a href="mailto:mehrozemaqsood8@gmail.com" class="block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]">Email</a>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-[14px] overflow-clip">
          <p class="font-ral text-[12px] font-bold uppercase leading-[normal] tracking-[2px] text-[#96a3f9]">Get in touch</p>
          <p class="font-ral text-[16px] font-medium leading-[normal] text-[rgba(255,255,255,0.85)]">Lahore, Pakistan</p>
          <a href="https://wa.me/923246319870" target="_blank" rel="noopener" class="block font-[Arial,Helvetica,sans-serif] text-[16px] not-italic leading-[normal] text-[rgba(255,255,255,0.85)]">+92 324 6319870</a>
          <p class="font-ral text-[16px] font-medium leading-[0] text-[rgba(255,255,255,0.85)]"><span class="leading-[normal]">Replies within </span><span class="font-[Arial,Helvetica,sans-serif] font-normal not-italic leading-[normal]">24</span><span class="leading-[normal]">h</span></p>
        </div>
      </div>
    </div>
    <div class="absolute left-[120px] top-[511px] h-[0.5px] w-[1200px] bg-white"></div>
  </footer>
