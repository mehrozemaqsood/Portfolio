---
import DocIcon from '../DocIcon.astro';
import HeroScreen from './HeroScreen.astro';
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
---
<div class="relative h-[460px] w-full overflow-clip" style="background-image:linear-gradient(1.76163389533248deg, rgb(122, 145, 246) 28.782%, rgb(49, 71, 166) 54.697%, rgb(0, 0, 0) 90.241%)">
  <div class="absolute left-0 right-0 top-0 h-[884px]" style="background-image:repeating-linear-gradient(90deg, rgba(255,255,255,.02) 0, rgba(0,0,0,.02) 34.909px)" aria-hidden="true"></div>
  <header class="absolute flex h-[43px] items-center left-[40px] top-[28px] w-[688px]">
    <nav class="flex gap-[12px] items-center relative shrink-0">
        <a href="/boltshift" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">BoltShift</p></a>
        <a href="/lensesonline" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">LensesOnline</p></a>
        <a href="/stichting-sportpark" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Stichting Sportpark</p></a>
        <a href="/zapier" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Zapier</p></a>
        <a href="/visual-design" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Visual Design</p></a>
      </nav>
    <div class="flex flex-[1_0_0] gap-[12px] items-start justify-end min-w-px relative">
      <a href="/Mehroze_UIUX_VisualDesigner_CV.pdf" target="_blank" rel="noopener" class="group border border-[#8499f8] border-solid flex gap-[10px] h-[43px] items-center overflow-clip px-[16px] relative rounded-[46px] shrink-0">
        <span class="absolute bg-white bottom-[-1.01px] h-[0.01px] left-[-1px] right-[-1px] transition-[height] duration-300 ease-out group-hover:h-[calc(100%+2px)]"></span>
        <p class="font-ral font-semibold leading-[16.5px] relative shrink-0 text-[#8499f8] text-[14px] whitespace-nowrap transition-colors duration-300 group-hover:text-[#020202]">View CV</p>
        <span class="relative shrink-0 size-[16px] [&_path]:transition-[stroke] [&_path]:duration-300 group-hover:[&_path]:stroke-[#020202]"><DocIcon /></span>
      </a>
      <a href="https://www.linkedin.com/in/muhammadmehrozemaqsood/" target="_blank" rel="noopener" class="bg-[#8499f8] cursor-pointer flex gap-[10px] h-[43px] items-center overflow-clip pl-[13px] pr-[6px] relative rounded-[46px] shrink-0">
        <p class="font-ral font-semibold leading-[16.5px] relative shrink-0 text-[14px] text-black whitespace-nowrap">Connect Now</p>
        <span class="border border-black border-solid grid place-items-center relative rounded-[41px] shrink-0 size-[32px]" style="background-image:linear-gradient(90deg, rgb(0, 0, 0) 0%, rgb(0, 0, 0) 100%), linear-gradient(90deg, rgb(168, 184, 255) 0%, rgb(168, 184, 255) 100%)"><Arrow /></span>
      </a>
    </div>
  </header>
  <h1 class="-translate-x-1/2 absolute bg-clip-text font-utara font-semibold leading-[normal] left-1/2 not-italic text-[92.782px] text-[transparent] text-center top-[103px] tracking-[-0.6294px] whitespace-nowrap" style="background-image:linear-gradient(0.21042730812268928deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%);-webkit-background-clip:text;background-clip:text">UXUI DESIGNER</h1>
  <div class="absolute bg-[#050505] h-[70.023px] left-[134px] rounded-tl-[21.12px] rounded-tr-[21.12px] top-[405.75px] w-[500.229px]"></div>
  <div class="absolute h-[56.009px] left-[192.05px] top-[368.5px] w-[384.331px]"><Img f="PortfolioH_124-1789" class="absolute inset-0 size-full object-bottom" sizes="385px" eager /></div>
  <div class="absolute h-[275.513px] left-[192.14px] top-[149px] w-[326.188px]"><Img f="R2_14-790" class="absolute inset-0 size-full object-bottom" sizes="327px" eager /></div>
  <div data-ms-patch class="absolute flex h-[7.263px] items-center justify-center left-[380.58px] top-[171.55px] w-[13.148px]"><div class="flex-none rotate-[1.01deg] h-[7.034px] w-[13.026px] relative"><Img f="PortfolioH_124-1792" class="absolute inset-0 size-full" sizes="14px" /></div></div>
  <HeroScreen left={192.14} top={149} k={0.586667} stage="t" inset={4} />
  <div class="absolute flex h-[168.829px] items-center justify-center left-[518.24px] top-[176.2px] w-[1.867px]"><div class="-rotate-90 flex-none"><div class="bg-gradient-to-l from-[#141611] h-[1.867px] relative to-[#020204] w-[168.829px]"></div></div></div>
  <div class="absolute flex h-[180.564px] items-center justify-center left-[241.93px] top-[167.4px] w-[2.4px]"><div class="-rotate-90 flex-none"><div class="bg-gradient-to-l from-[#262528] h-[2.4px] relative rounded-bl-[1.76px] rounded-tl-[1.76px] to-[#020204] w-[180.564px]"></div></div></div>
  <div class="absolute flex h-[182.334px] items-center justify-center left-[239.57px] top-[166.11px] w-[2.667px]"><div class="flex-none rotate-[-0.14deg]"><div class="bg-gradient-to-b from-[#414344] h-[182.329px] relative rounded-bl-[0.88px] rounded-tl-[0.88px] to-[#4a4b50] w-[2.22px]"></div></div></div>
  <p class="absolute font-utara font-bold leading-[17.28px] left-[611px] not-italic text-[#96a3f9] text-[17px] top-[225.66px] tracking-[2.304px] uppercase whitespace-nowrap">Portfolio</p>
</div>
