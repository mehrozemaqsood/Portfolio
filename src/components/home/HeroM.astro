---
import HeroScreen from './HeroScreen.astro';
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
---
<div class="relative h-[430px] w-full overflow-clip" style="background-image:linear-gradient(3.2403834017979847deg, rgb(122, 145, 246) 28.782%, rgb(49, 71, 166) 54.697%, rgb(0, 0, 0) 90.241%)">
  <div class="absolute left-0 right-0 top-0 h-[884px]" style="background-image:repeating-linear-gradient(90deg, rgba(255,255,255,.02) 0, rgba(0,0,0,.02) 17.727px)" aria-hidden="true"></div>
  <header class="absolute flex h-[43px] items-center justify-between left-[20px] top-[24px] w-[350px]">
    <a href="/" aria-label="Home" class="flex h-[22px] w-[38.211px] shrink-0 items-center justify-center">
      <div class="flex-none -skew-x-[28deg] scale-y-[0.88]">
        <div class="relative flex cursor-pointer items-start gap-[4.257px]">
          <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-white"></span>
          <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-white"></span>
          <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-white"></span>
        </div>
      </div>
    </a>
    <a href="#menu-m" id="menu-open-m" aria-label="Open menu" class="flex size-[43px] shrink-0 cursor-pointer flex-col items-center justify-center gap-[5px] overflow-clip rounded-[22px]">
      <span class="h-[1.5px] w-[18px] shrink-0 rounded-[1px] bg-[#b8c2ff]"></span>
      <span class="h-[1.5px] w-[18px] shrink-0 rounded-[1px] bg-[#b8c2ff]"></span>
      <span class="h-[1.5px] w-[18px] shrink-0 rounded-[1px] bg-[#b8c2ff]"></span>
    </a>
  </header>
  <h1 class="-translate-x-1/2 absolute bg-clip-text font-utara font-semibold leading-[normal] not-italic text-[47px] text-[transparent] text-center tracking-[-0.3188px] whitespace-nowrap" style="left:calc(50% - 0.74px);top:108px;background-image:linear-gradient(0.21042730912232344deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(172.17686694961736deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%), linear-gradient(90deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100%);-webkit-background-clip:text;background-clip:text">UXUI DESIGNER</h1>
  <div class="absolute bg-[#050505] h-[54.593px] left-0 top-[350.17px] w-[390px]"></div>
  <div class="absolute h-[43.667px] left-[45.26px] top-[321.13px] w-[299.641px]"><Img f="PortfolioH_124-1789" class="absolute inset-0 size-full object-bottom" sizes="300px" eager /></div>
  <div class="absolute h-[214.802px] left-[45.33px] top-[150px] w-[254.31px]"><Img f="R2_14-790" class="absolute inset-0 size-full object-bottom" sizes="255px" eager /></div>
  <div data-ms-patch class="absolute flex h-[5.663px] items-center justify-center left-[192.25px] top-[167.58px] w-[10.251px]"><div class="flex-none rotate-[1.01deg] h-[5.484px] w-[10.156px] relative"><Img f="PortfolioH_124-1792" class="absolute inset-0 size-full" sizes="11px" /></div></div>
  <HeroScreen left={45.33} top={150} k={0.457390} stage="m" inset={6} />
  <div class="absolute flex h-[131.626px] items-center justify-center left-[299.57px] top-[171.21px] w-[1.456px]"><div class="-rotate-90 flex-none"><div class="bg-gradient-to-l from-[#141611] h-[1.456px] relative to-[#020204] w-[131.626px]"></div></div></div>
  <div class="absolute flex h-[140.775px] items-center justify-center left-[84.15px] top-[164.35px] w-[1.871px]"><div class="-rotate-90 flex-none"><div class="bg-gradient-to-l from-[#262528] h-[1.871px] relative rounded-bl-[1.372px] rounded-tl-[1.372px] to-[#020204] w-[140.775px]"></div></div></div>
  <div class="absolute flex h-[142.156px] items-center justify-center left-[82.31px] top-[163.34px] w-[2.079px]"><div class="flex-none rotate-[-0.14deg]"><div class="bg-gradient-to-b from-[#414344] h-[142.152px] relative rounded-bl-[0.686px] rounded-tl-[0.686px] to-[#4a4b50] w-[1.731px]"></div></div></div>
  <p class="absolute font-utara font-bold leading-[17.28px] left-[321px] not-italic text-[#96a3f9] text-[5px] top-[160.41px] tracking-[2.304px] uppercase whitespace-nowrap">Portfolio</p>
</div>
