---
import Img from '../Img.astro';
---
<section id="work" class="bg-[#020202] relative w-full h-[1964px] overflow-clip">
  <div class="absolute left-[69px] top-[93px] w-[1314px] flex flex-col items-center">
    <h2 class="font-utara font-semibold text-[148px] leading-[170px] text-center text-white tracking-[-1.16px] min-w-full whitespace-nowrap">SELECTED WORKS</h2>
    <div class="flex items-center justify-between relative shrink-0 w-[1302px]">
      <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap w-[116px]">Product Design</p>
      <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap">WEb Design</p>
      <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap">UX/ui</p>
      <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap">VISUAL Design</p>
    </div>
  </div>
  <div class="-translate-x-1/2 absolute gap-x-[20px] gap-y-[20px] grid grid-cols-[repeat(2,minmax(0,1fr))] left-1/2 top-[372px] w-[1400px]">
    <a href="/lensesonline" class="col-1 row-1 flex flex-col gap-[16px] items-start justify-self-stretch relative self-start shrink-0 project-card">
      <div class="h-[636px] overflow-clip relative shrink-0 w-full">
        <Img f="PortfolioH_116-16401" alt="LensesOnline case study" class="absolute inset-0 size-full object-cover" sizes="690px" />
          <div class="absolute flex gap-[10px] h-[29px] items-start left-[20px] top-[587px]">
            <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">E-COMMERCE</p></div>
            <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">EYE-CARE</p></div>
          </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[48px] relative shrink-0 text-[#f2f0ef] text-[40px] text-left tracking-[-0.8px] whitespace-nowrap">LensesOnline</h3></div>
    </a>
    <a href="/boltshift" class="col-2 row-1 flex flex-col gap-[16px] items-start justify-self-stretch relative self-start shrink-0 project-card">
      <div class="h-[636px] overflow-clip relative shrink-0 w-full">
        <Img f="PortfolioH_116-16412" alt="BoltShift case study" class="absolute inset-0 size-full object-cover" sizes="690px" />
          <div class="absolute flex gap-[10px] h-[29px] items-start left-[20px] top-[587px]">
            <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">B2B SaaS</p></div>
            <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Customer Success Management</p></div>
          </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[48px] relative shrink-0 text-[#f2f0ef] text-[40px] text-left tracking-[-0.8px] whitespace-nowrap">BoltShift</h3></div>
    </a>
    <a href="/stichting-sportpark" class="col-2 row-2 flex flex-col gap-[16px] items-start justify-self-stretch relative self-start shrink-0 project-card">
      <div class="h-[636px] overflow-clip relative shrink-0 w-full">
        <Img f="PortfolioH_116-16423" alt="Stichting Sportpark case study" class="absolute inset-0 size-full object-cover" sizes="690px" />
          <div class="absolute flex gap-[10px] h-[29px] items-start left-[20px] top-[587px]">
            <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Public Sector</p></div>
            <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Sports & Recreation</p></div>
          </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[48px] relative shrink-0 text-[#f2f0ef] text-[40px] text-left tracking-[-0.8px] whitespace-nowrap">Stichting Sportpark</h3></div>
    </a>
    <a href="/zapier" class="col-1 row-2 flex flex-col gap-[16px] items-start justify-self-stretch relative self-start shrink-0 project-card">
      <div class="h-[636px] overflow-clip relative shrink-0 w-full">
        <Img f="R2_116-16434" alt="Zapier case study" class="absolute inset-0 size-full object-cover" sizes="690px" /><span class="sr-only">Fintech, Digital Wallet</span>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[48px] relative shrink-0 text-[#f2f0ef] text-[40px] text-left tracking-[-0.8px] whitespace-nowrap">Zapier</h3></div>
    </a>
  </div>
</section>
