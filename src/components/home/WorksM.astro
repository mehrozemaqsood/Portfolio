---
import Img from '../Img.astro';
---
<section id="work-m" class="bg-[#020202] relative w-full flex flex-col gap-[32px] items-center pb-[56px] pt-[48px] px-[20px]">
  <div class="bg-[#020202] flex flex-col items-start overflow-clip relative shrink-0 w-full">
    <div class="flex flex-col items-center relative shrink-0 w-full">
      <h2 class="font-utara font-semibold text-[39.422px] leading-[45.282px] text-center text-white tracking-[-0.309px] whitespace-nowrap w-[350px]">SELECTED WORKS</h2>
      <div class="flex flex-wrap content-center gap-x-[20px] gap-y-[8px] items-center relative shrink-0 w-full">
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap w-[116px]">Product Design</p>
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap flex gap-[4px]"><span>WEb</span><span>Design</span></p>
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap">UX/ui</p>
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap flex gap-[4px]"><span>VISUAL</span><span>Design</span></p>
      </div>
    </div>
  </div>
  <div class="flex flex-col gap-[36px] items-start relative shrink-0 w-full">
    <a href="/boltshift" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-full">
      <div class="h-[322px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_bolt" alt="BoltShift case study" class="absolute inset-0 size-full object-cover" sizes="350px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[236px] w-[310px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">B2B SaaS</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Customer Success Management</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[33.6px] relative shrink-0 text-[#f2f0ef] text-[28px] text-left tracking-[-0.56px] whitespace-nowrap">BoltShift</h3></div>
    </a>
    <a href="/lensesonline" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-full">
      <div class="h-[322px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_lensesbg" class="absolute inset-0 size-full object-cover" sizes="350px" /><Img f="WorksT_lenses" alt="LensesOnline case study" class="absolute inset-0 size-full object-cover" sizes="350px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[273px] w-[310px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">E-COMMERCE</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">EYE-CARE</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[33.6px] relative shrink-0 text-[#f2f0ef] text-[28px] text-left tracking-[-0.56px] whitespace-nowrap">LensesOnline</h3></div>
    </a>
    <a href="/stichting-sportpark" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-full">
      <div class="h-[322px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_stichting" alt="Stichting Sportpark case study" class="absolute inset-0 size-full object-cover" sizes="350px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[236px] w-[310px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Public Sector</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Sports &amp; Recreation</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[33.6px] relative shrink-0 text-[#f2f0ef] text-[28px] text-left tracking-[-0.56px] whitespace-nowrap">Stichting Sportpark</h3></div>
    </a>
    <a href="/zapier" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-full">
      <div class="h-[322px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_zapier" alt="Zapier case study" class="absolute inset-0 size-full object-cover" sizes="350px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[273px] w-[310px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Fintech</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Digital Wallet</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[33.6px] relative shrink-0 text-[#f2f0ef] text-[28px] text-left tracking-[-0.56px] whitespace-nowrap">Zapier</h3></div>
    </a>
    <a href="/visual-design" class="flex flex-col gap-[16px] items-start relative shrink-0 w-full project-card">
      <div class="h-[322px] overflow-clip relative shrink-0 w-full" style="background-image:linear-gradient(180deg, rgba(2, 2, 2, 0.8) 4.6191%, rgb(110, 110, 110) 60.577%, rgb(78, 78, 78) 100%), linear-gradient(90deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.2) 100%)">
        <Img f="PortfolioH_490-2598" alt="Visual Design: social posts, case studies and branding" class="absolute max-w-none h-[53%] left-[-35%] top-[38%] w-[170%]" sizes="600px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[20px] w-[310px]"><div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">SOCIAL POSTS</p></div><div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">CASE STUDIES</p></div><div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">BraNding</p></div></div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[33.6px] text-[28px] tracking-[-0.56px] relative shrink-0 text-[#f2f0ef] text-left whitespace-nowrap">Visual Design</h3></div>
    </a>
  </div>
</section>
