---
import Img from '../Img.astro';
const hobbies = [['gym','Gym',false],['game','E-Gaming',true],['camera','Photography',false],['colorize','Colour-grading',false]];
---
<section id="about-m" class="relative -mt-[70px] flex w-full flex-col items-start overflow-clip bg-[#020202] px-[20px] pb-[64px] pt-[32px]">
  <div class="relative flex w-full shrink-0 flex-col items-start gap-[24px]">
    <div class="flex w-full shrink-0 flex-col items-start">
      <div class="flex w-[462.953px] shrink-0 flex-col items-start"><h2 class="h-[50.14px] font-utara text-[32px] font-semibold not-italic leading-[49.92px] tracking-[-2.0924px] text-white whitespace-nowrap">ABOUT ME</h2></div>
    </div>
    <p class="h-[331px] w-full shrink-0 font-ral text-[17px] font-normal leading-[0] tracking-[-0.4624px] text-[#f5f5f5]"><span class="leading-[30.056px]">I am a </span><span class="font-medium leading-[30.056px]">UI/UX Designer</span><span class="leading-[30.056px]"> and</span><span class="italic leading-[30.056px]"> Computer Science</span><span class="leading-[30.056px]"> Graduate from </span><span class="font-medium leading-[30.056px]">FAST-NUCES</span><span class="leading-[30.056px]"> who bridges the gap between aesthetic product design and technical execution. With </span><span class="font-inter font-medium not-italic leading-[30.056px]">3+</span><span class="leading-[30.056px]"> years of experience, I combine structured visual systems with advanced AI workflows to build scalable, developer-ready interfaces. I turn complex problems into functional, production-aligned digital experiences, focusing on robust design systems, usability, and seamless developer handoff.</span></p>
    <div class="flex w-full shrink-0 items-start">
      <div class="flex min-w-px flex-[1_0_0] items-start gap-[16px]">
        <div class="relative size-[112px] shrink-0 overflow-clip border-[1.167px] border-solid border-[#96a3f9]" style="background-image:linear-gradient(13.04373406749211deg, rgb(122, 145, 246) 19.019%, rgb(49, 71, 166) 50.509%, rgb(0, 0, 0) 81.4%)">
          <div class="-translate-x-1/2 absolute h-[108.111px] left-[calc(50%+1.2px)] top-[11.58px] w-[103.444px]"><Img f="PortfolioH_35-319" alt="Portrait of Mehroze Maqsood" class="absolute inset-0 size-full object-cover" sizes="104px" /></div>
        </div>
        <div class="flex min-w-px flex-[1_0_0] flex-col items-start gap-[20px]">
          <div class="flex w-full shrink-0 flex-col items-start">
            <p class="h-[22.8px] font-utara text-[24px] font-semibold not-italic leading-[22.704px] text-[#96a3f9] whitespace-nowrap">Mehroze Maqsood</p>
            <div class="flex w-full shrink-0 flex-col items-start pt-[7.2px]"><p class="h-[30.147px] font-ral text-[20px] font-medium not-italic leading-[0] text-[#f5f5f5] whitespace-nowrap"><span class="font-utara font-semibold leading-[30px]">UX/UI</span><span class="font-inter font-medium leading-[30px]"> </span><span class="font-inter font-normal leading-[30px]">Designer</span></p></div>
          </div>
          <div class="flex w-full shrink-0 cursor-pointer items-start gap-[20px]">
            <a href="https://www.linkedin.com/in/muhammadmehrozemaqsood/" target="_blank" rel="noopener" class="flex shrink-0 items-center" aria-label="LinkedIn"><span class="relative size-[32px] shrink-0"><Img f="PortfolioH_60-14598" class="absolute inset-0 size-full" sizes="32px" /></span></a>
            <a href="mailto:mehrozemaqsood8@gmail.com" class="flex shrink-0 items-center" aria-label="Email"><span class="relative size-[32px] shrink-0 overflow-clip rounded-[6px] bg-white"><span class="absolute" style="inset:20.34% 10.71% 20.71% 10.71%"><img src="/icons/gmail.svg" alt="" class="absolute block inset-0 max-w-none size-full" /></span></span></a>
            <a href="https://www.behance.net/mehrozemaqsood" target="_blank" rel="noopener" class="flex shrink-0 items-center" aria-label="Behance"><span class="relative size-[32px] shrink-0"><Img f="PortfolioH_60-14616" class="absolute inset-0 size-full" sizes="32px" /></span></a>
          </div>
        </div>
      </div>
    </div>
      <div class="flex w-full shrink-0 flex-col items-start">
        <div class="flex w-full shrink-0 flex-col items-start gap-[8px]">
          <div class="flex w-full shrink-0 items-center gap-[12px]">
            <img src="/icons/home.svg" alt="" width="24" height="24" class="relative size-[24px] shrink-0" />
            <div class="flex min-w-px flex-[1_0_0] flex-col items-start"><p class="h-[32px] font-ral text-[20.8px] font-medium leading-[31.2px] text-[#f5f5f5] whitespace-nowrap">Lahore, Pakistan</p></div>
          </div>
          <div class="flex w-full shrink-0 items-center gap-[12px]">
            <img src="/icons/phone.svg" alt="" width="24" height="24" class="relative size-[24px] shrink-0" />
            <a href="https://wa.me/923246319870" target="_blank" rel="noopener" class="flex min-w-px flex-[1_0_0] cursor-pointer flex-col items-start"><p class="h-[32px] overflow-hidden text-ellipsis text-left font-['Arial',sans-serif] text-[20.8px] not-italic leading-[31.2px] text-[#f5f5f5] whitespace-nowrap">+92 324 6319870</p></a>
          </div>
        </div>
      </div>
    <div class="flex w-full shrink-0 flex-col items-start">
      <h3 class="h-[40px] font-utara text-[26.4px] font-semibold not-italic leading-[39.6px] text-[#f5f5f5] whitespace-nowrap">Hobbies</h3>
      <div class="flex w-full shrink-0 flex-col items-start pt-[12.8px]">
        <div class="flex w-full shrink-0 flex-col flex-wrap content-start items-start gap-x-[24px] gap-y-[12px]">
          {hobbies.map(([i, t, fixed]) => (
            <div class="flex shrink-0 items-center gap-[12px]">
              <img src={`/icons/${i}.svg`} alt="" width="24" height="24" class="relative size-[24px] shrink-0" />
              <p class={`font-ral text-[21.6px] font-normal leading-[21.6px] text-[#f5f5f5] ${fixed ? 'w-[116px]' : 'whitespace-nowrap'}`}>{t}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="flex w-full shrink-0 flex-col items-start gap-[22px]">
      <div class="flex w-full shrink-0 flex-col items-start">
        <div class="flex w-full shrink-0 flex-col items-start">
          <h3 class="h-[40px] font-utara text-[26.4px] font-semibold not-italic leading-[39.6px] text-[#f5f5f5] whitespace-nowrap">Tools</h3>
          <ul class="m-0 flex w-full shrink-0 list-none flex-col items-start gap-[4.48px] p-0" style="padding-top:12.8px">
            {['Figma', 'Claude Design', 'Google Stitch', 'Loveable'].map((t) => (
              <li class="flex h-[22px] w-full shrink-0 items-center gap-[13.6px]"><span class="relative size-[7.672px] shrink-0 rounded-[3.836px] bg-[#96a3f9]"></span><p class="font-ral text-[21.6px] font-normal leading-[21.6px] text-[#f5f5f5] whitespace-nowrap">{t}</p></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-[24px] pt-[24px]">
        <div class="flex shrink-0 items-center gap-[20px]">
          <img src="/icons/figma.svg" alt="Figma" width="32" height="32" class="relative size-[32px] shrink-0" />
          <img src="/icons/claude.svg" alt="Claude" width="32" height="31.618" class="relative h-[31.618px] w-[32px] shrink-0" />
        </div>
        <img src="/icons/lovable.svg" alt="Lovable" width="32" height="32" class="relative size-[32px] shrink-0" />
        <div class="relative h-[32px] w-[144px] shrink-0"><Img f="PortfolioH_47-823" alt="Stitch" class="absolute inset-0 size-full" sizes="144px" /></div>
      </div>
    </div>
  </div>
</section>
