---
import { testimonials as deck } from './testimonials';
// back cards of the fan (tablet):[wrapper left, top, w, h, rotate, scale, secondLine]
const back = [
  { l: 89.71, t: -37.6, w: 447.836, h: 227.825, r: 11, k: 0.75, co: 'Job title' },
  { l: 71.14, t: -32.98, w: 474.688, h: 226.825, r: 8.8, k: 0.8, co: 'Job title' },
  { l: 52.85, t: -26.95, w: 500.42, h: 223.447, r: 6.6, k: 0.85, co: 'Company name' },
  { l: 34.88, t: -19.47, w: 524.907, h: 217.654, r: 4.4, k: 0.9, co: 'Company name' },
  { l: 17.25, t: -10.5, w: 548.029, h: 209.42, r: 2.2, k: 0.95, co: 'Company name' },
];
---
<section class="relative flex w-full flex-col gap-[64px] overflow-clip px-[40px] py-[96px]" style="background-image:linear-gradient(182.72677075753506deg, rgb(0, 0, 0) 14.763%, rgb(92, 116, 218) 29.426%, rgb(49, 71, 166) 43.127%, rgb(0, 0, 0) 68.574%), linear-gradient(90deg, rgb(2, 2, 2) 0%, rgb(2, 2, 2) 100%)">
  <div class="absolute inset-x-0 top-0 bottom-[-0.07px] overflow-clip" aria-hidden="true">
    {[[192, -200, 0], [384, -520, 1.3], [576, -340, 2.6]].map(([x, y, d]) => (
      <>
        <div class="absolute top-0 h-[720px] w-px" style={`left:${x}px;background-image:linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.24) 22%, rgba(255,255,255,0.12) 70%, rgba(255,255,255,0) 100%)`}></div>
        <div class="flow-streak absolute h-[180px] w-px" style={`left:${x}px;top:${y}px;--d:${d}s;background-image:linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.85) 60%, rgba(255,255,255,0) 100%)`}></div>
      </>
    ))}
  </div>
  <div class="relative flex w-full shrink-0 flex-col items-center">
    <div class="flex flex-col justify-center whitespace-nowrap text-center font-utara text-[77.492px] font-semibold leading-[0] tracking-[-0.6074px] text-white"><p class="leading-[89.011px]">RECOMMENDER</p></div>
    <div class="flex w-full shrink-0 items-center justify-between font-ral text-[15px] font-medium uppercase leading-[21px] tracking-[-0.3px] text-[rgba(255,255,255,0.6)]">
      <div class="flex w-[116px] items-center"><p class="whitespace-nowrap">What</p></div>
      <div class="flex items-center"><p class="whitespace-nowrap">Other</p></div>
      <p class="whitespace-nowrap">SAY</p>
      <div class="flex items-center gap-[4px] whitespace-nowrap"><p>ABOUT</p><p>ME</p></div>
    </div>
  </div>
  <div class="relative flex w-full shrink-0 flex-col items-center gap-[40px]">
    <p class="font-ral text-[14px] font-medium uppercase leading-[20px] text-white opacity-50 whitespace-nowrap">[ DRAG TO SWIPE ]</p>
    <div class="rec-stack relative h-[198.71px] w-[569.664px] shrink-0 touch-pan-y select-none" style="cursor:grab" data-deck={JSON.stringify(deck)}>
      {back.map((c, b) => (
        <div class="rec-back absolute flex items-center justify-center" data-pos={5 - b} style={`left:${c.l}px;top:${c.t}px;width:${c.w}px;height:${c.h}px`}>
          <div class="flex-none" style={`transform:rotate(${c.r}deg) scale(${c.k})`}>
            <div class="rec-card" style="zoom:1.15">
              <div class="rec-q"><div class="rec-qi"><div class="rec-qt"><p data-f="q">{deck[5 - b].q}</p></div><div class="rec-qb"></div></div></div>
              <div class="rec-c"><div class="rec-l"><p data-f="r">{deck[5 - b].r}</p><p data-f="c">{deck[5 - b].c}</p></div><p class="rec-n" data-f="n">{deck[5 - b].n}</p></div>
            </div>
          </div>
        </div>
      ))}
      <div class="rec-front absolute left-0 top-0 flex h-[198.71px] w-[569.664px] items-center justify-center" style="will-change:transform">
        <div class="rec-card" style="zoom:1.15">
          <div class="rec-q"><div class="rec-qi"><div class="rec-qt"><p data-f="q">{deck[0].q}</p></div><div class="rec-qb"></div></div></div>
          <div class="rec-c"><div class="rec-l"><p data-f="r">{deck[0].r}</p><p data-f="c">{deck[0].c}</p></div><p class="rec-n" data-f="n">{deck[0].n}</p></div>
        </div>
      </div>
    </div>
  </div>
</section>
