---
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
import HeroScreen from './HeroScreen.astro';
---
<div class="relative h-[788px] w-full overflow-clip" style="background-image:linear-gradient(1.6095533985933344deg, rgb(122, 145, 246) 28.782%, rgb(49, 71, 166) 54.697%, rgb(0, 0, 0) 90.241%)">
  <div class="absolute left-0 right-0 top-0 h-[884px]" style="background-image:repeating-linear-gradient(90deg, rgba(0,0,0,.02) 0, rgba(255,255,255,.02) 65.4545px)" aria-hidden="true"></div>
  <header class="absolute flex h-[43px] items-center left-[82px] top-[30px] w-[1277px]">
    <div class="relative flex h-[22px] w-[140px] shrink-0 flex-col items-start pr-[99px]">
      <a href="/" aria-label="Home" class="absolute left-[-5.85px] top-0 flex h-[22px] w-[38.211px] items-center justify-center">
        <div class="flex-none -skew-x-[28deg] scale-y-[0.88]">
          <div class="relative flex cursor-pointer items-start gap-[4.257px]">
            <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-white"></span>
            <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-white"></span>
            <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-white"></span>
          </div>
        </div>
      </a>
    </div>
    <nav class="flex gap-[31px] items-center relative shrink-0">
        <a href="/boltshift" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">BoltShift</p></a>
        <a href="/lensesonline" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">LensesOnline</p></a>
        <a href="/stichting-sportpark" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Stichting Sportpark</p></a>
        <a href="/zapier" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Zapier</p></a>
        <a href="/visual-design" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Visual Design</p></a>
      </nav>
    <div class="flex flex-[1_0_0] gap-[12px] items-start justify-end min-w-px relative">
      <a href="/Mehroze_UIUX_CV.pdf" target="_blank" rel="noopener" class="group border border-[#8499f8] border-solid flex gap-[10px] h-[43px] items-center overflow-clip px-[16px] relative rounded-[46px] shrink-0">
        <span class="absolute bg-white bottom-[-1.01px] h-[0.01px] left-[-1px] right-[-1px] transition-[height] duration-300 ease-out group-hover:h-[calc(100%+2px)]"></span>
        <p class="font-ral font-semibold leading-[16.5px] relative shrink-0 text-[#8499f8] text-[14px] whitespace-nowrap transition-colors duration-300 group-hover:text-[#020202]">View CV</p>
        <span class="relative shrink-0 size-[16px] [&_path]:transition-[stroke] [&_path]:duration-300 group-hover:[&_path]:stroke-[#020202]"><Arrow /></span>
      </a>
      <a href="https://www.linkedin.com/in/muhammadmehrozemaqsood/" target="_blank" rel="noopener" class="bg-[#8499f8] cursor-pointer flex gap-[10px] h-[43px] items-center overflow-clip pl-[13px] pr-[6px] relative rounded-[46px] shrink-0">
        <span class="absolute bg-white bottom-[-0.01px] h-[0.01px] left-0 right-0"></span>
        <p class="font-ral font-semibold leading-[16.5px] relative shrink-0 text-[14px] text-black whitespace-nowrap">Connect Now</p>
        <span class="border border-black border-solid grid place-items-center relative rounded-[41px] shrink-0 size-[32px]" style="background-image:linear-gradient(90deg, rgb(0, 0, 0) 0%, rgb(0, 0, 0) 100%), linear-gradient(90deg, rgb(168, 184, 255) 0%, rgb(168, 184, 255) 100%)"><Arrow /></span>
      </a>
    </div>
  </header>
  <h1 class="-translate-x-1/2 absolute bg-clip-text font-utara font-semibold leading-[normal] left-1/2 not-italic text-[171px] text-[transparent] text-center top-[137px] tracking-[-1.16px] whitespace-nowrap" style="background-image:linear-gradient(0.2104273092080149deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(172.17686694647062deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%), linear-gradient(90deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100%);-webkit-background-clip:text;background-clip:text">UXUI DESIGNER</h1>
  <div class="absolute bg-[#050505] h-[119.357px] left-[294px] rounded-tl-[36px] rounded-tr-[36px] top-[675.64px] w-[852.663px]"></div>
  <div class="absolute h-[95.471px] left-[392.95px] top-[612.15px] w-[655.109px]"><Img f="PortfolioH_124-1789" class="absolute inset-0 size-full" sizes="655px" eager /></div>
  <div class="absolute h-[469.625px] left-[393.1px] top-[238px] w-[556.002px]"><Img f="R2_14-790" class="absolute inset-0 size-full" sizes="556px" eager /></div>
  <div data-ms-patch class="absolute h-[11.99px] left-[714.41px] top-[276.64px] w-[22.204px] rotate-[1.01deg]"><Img f="PortfolioH_124-1792" class="absolute inset-0 size-full" sizes="23px" /></div>
  <HeroScreen />
  <div class="absolute h-[4.092px] w-[307.779px] left-[326.13px] top-[421.21px] origin-center -rotate-90 bg-gradient-to-l from-[#262528] to-[#020204] rounded-bl-[3px] rounded-tl-[3px]"></div>
  <div class="absolute h-[3.182px] w-[287.776px] left-[806.66px] top-[426.67px] origin-center -rotate-90 bg-gradient-to-l from-[#141611] to-[#020204]"></div>
  <div class="absolute bg-gradient-to-b from-[#414344] to-[#4a4b50] h-[310.788px] w-[3.785px] left-[474.33px] top-[267.17px] -rotate-[0.14deg] rounded-bl-[1.5px] rounded-tl-[1.5px]"></div>
  <p class="absolute font-utara font-bold leading-[17.28px] left-[1233px] not-italic text-[#96a3f9] text-[17px] top-[326px] tracking-[2.304px] uppercase whitespace-nowrap">Portfolio</p>
</div>
