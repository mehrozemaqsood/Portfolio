---
const links = [['01', 'BoltShift', '/boltshift'], ['02', 'LensesOnline', '/lensesonline'], ['03', 'Stichting Sportpark', '/stichting-sportpark'], ['04', 'Zapier', '/zapier'], ['05', 'Visual Design', '/visual-design']];
---
<div id="menu-m" role="dialog" aria-modal="true" aria-label="Menu" hidden class="menu-m fixed left-0 top-0 z-[60] flex w-[390px] flex-col items-start gap-[40px] overflow-y-auto bg-[#020202] px-[20px] pb-[40px] pt-[24px]" style="height:calc(100dvh / var(--z,1))">
  <div class="flex w-full shrink-0 items-center justify-between overflow-clip">
    <button type="button" id="menu-close-m" aria-label="Close menu" class="block size-[43px] shrink-0"><img src="/icons/menu-close.svg" alt="" width="43" height="43" class="block size-full" /></button>
    <a href="https://www.linkedin.com/in/muhammadmehrozemaqsood/" target="_blank" rel="noopener" class="bg-[#8499f8] flex h-[43px] shrink-0 items-center gap-[10px] overflow-clip rounded-[46px] pl-[13px] pr-[6px]">
      <p class="font-ral text-[14px] font-semibold leading-[16.5px] text-black whitespace-nowrap">Connect Now</p>
      <span class="grid size-[32px] shrink-0 place-items-center rounded-[41px] border border-solid border-black" style="background-image:linear-gradient(90deg, rgb(0, 0, 0) 0%, rgb(0, 0, 0) 100%), linear-gradient(90deg, rgb(168, 184, 255) 0%, rgb(168, 184, 255) 100%)"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.667 4.667H11.334V11.334" stroke="#A8B8FF" stroke-width="0.8667" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.667 11.334L11.334 4.667" stroke="#A8B8FF" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </a>
  </div>
  <nav class="flex w-full shrink-0 flex-col items-start gap-[8px] overflow-clip text-left font-ral font-medium leading-[normal] whitespace-nowrap">
    {links.map(([n, t, h]) => (
      <a href={h} class="menu-link flex h-[100px] w-full shrink-0 items-end gap-[16px] overflow-clip border-b border-solid border-[rgba(255,255,255,0.1)] py-[14px]"><span class="text-[14px] text-[#808cff]">{n}</span><span class="text-[36px] text-white">{t}</span></a>
    ))}
  </nav>
</div>
<script>
  const m = document.getElementById('menu-m');
  const open = document.getElementById('menu-open-m');
  const set = (on: boolean) => { if (!m) return; m.hidden = !on; document.documentElement.style.overflow = on ? 'hidden' : ''; };
  open?.addEventListener('click', (e) => { e.preventDefault(); set(true); });
  document.getElementById('menu-close-m')?.addEventListener('click', () => set(false));
  m?.querySelectorAll('.menu-link').forEach((a) => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
