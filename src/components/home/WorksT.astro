---
import Img from '../Img.astro';
---
<section id="work-t" class="bg-[#020202] relative w-full flex flex-col gap-[40px] items-center pb-[72px] pt-[64px] px-[40px]">
  <div class="bg-[#020202] flex flex-col items-start overflow-clip relative shrink-0 w-full">
    <div class="flex flex-col items-center relative shrink-0 w-full">
      <h2 class="font-utara font-semibold text-[77.492px] leading-[89.011px] text-center text-white tracking-[-0.6074px] whitespace-nowrap">SELECTED WORKS</h2>
      <div class="flex items-center justify-between relative shrink-0 w-full">
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap w-[116px]">Product Design</p>
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap flex gap-[4px]"><span>WEb</span><span>Design</span></p>
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap">UX/ui</p>
        <p class="font-ral font-medium leading-[21px] text-[15px] text-[rgba(255,255,255,0.6)] text-center tracking-[-0.3px] uppercase whitespace-nowrap flex gap-[4px]"><span>VISUAL</span><span>Design</span></p>
      </div>
    </div>
  </div>
  <div class="flex flex-wrap gap-x-[24px] gap-y-[40px] items-start relative shrink-0 w-full">
    <a href="/boltshift" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-[332px]">
      <div class="h-[306.017px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_bolt" alt="BoltShift case study" class="absolute inset-0 size-full object-cover" sizes="332px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[220.02px] w-[292px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">B2B SaaS</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Customer Success Management</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[38.4px] relative shrink-0 text-[#f2f0ef] text-[32px] text-left tracking-[-0.64px] whitespace-nowrap">BoltShift</h3></div>
    </a>
    <a href="/lensesonline" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-[332px]">
      <div class="h-[306.017px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_lensesbg" class="absolute inset-0 size-full object-cover" sizes="332px" /><Img f="WorksT_lenses" alt="LensesOnline case study" class="absolute inset-0 size-full object-cover" sizes="332px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[257.02px] w-[292px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">E-COMMERCE</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">EYE-CARE</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[38.4px] relative shrink-0 text-[#f2f0ef] text-[32px] text-left tracking-[-0.64px] whitespace-nowrap">LensesOnline</h3></div>
    </a>
    <a href="/stichting-sportpark" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-[332px]">
      <div class="h-[306.017px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_stichting" alt="Stichting Sportpark case study" class="absolute inset-0 size-full object-cover" sizes="332px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[220.02px] w-[292px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Public Sector</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Sports &amp; Recreation</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[38.4px] relative shrink-0 text-[#f2f0ef] text-[32px] text-left tracking-[-0.64px] whitespace-nowrap">Stichting Sportpark</h3></div>
    </a>
    <a href="/zapier" class="project-card flex flex-col gap-[16px] items-start relative shrink-0 w-[332px]">
      <div class="h-[306.017px] overflow-clip relative shrink-0 w-full">
        <Img f="WorksT_zapier" alt="Zapier case study" class="absolute inset-0 size-full object-cover" sizes="332px" />
        <div class="absolute flex flex-wrap gap-[8px] items-start left-[20px] top-[257.02px] w-[292px]">
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Fintech</p></div>
          <div class="backdrop-blur-[40px] bg-[rgba(0,0,0,0)] flex h-[29px] items-center justify-center px-[8px] py-[4px] relative rounded-[8px] shrink-0"><p class="font-ral font-medium leading-[21px] relative shrink-0 text-[#f2f0ef] text-[15px] text-left tracking-[-0.3px] uppercase whitespace-nowrap">Digital Wallet</p></div>
        </div>
      </div>
      <div class="flex flex-col h-[48px] items-start overflow-clip relative shrink-0 w-full"><h3 class="font-ral font-semibold leading-[38.4px] relative shrink-0 text-[#f2f0ef] text-[32px] text-left tracking-[-0.64px] whitespace-nowrap">Zapier</h3></div>
    </a>
  </div>
</section>
