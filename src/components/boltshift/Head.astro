---
// Section header used by every body section: eyebrow + big Utara title + lead.
const { eyebrow, title, lead, leadClass = 'w-[1000px]' } = Astro.props;
---
<p class="font-utara text-[14px] font-bold not-italic leading-[normal] tracking-[2px] text-[#0083f0] whitespace-pre">{eyebrow}</p>
<h2 class="font-utara text-[84px] font-semibold not-italic leading-[88px] tracking-[-2.5px] text-white whitespace-nowrap">{title}</h2>
<p class={`font-ral text-[30px] font-semibold leading-[40px] text-white ${leadClass}`}>{lead}</p>
