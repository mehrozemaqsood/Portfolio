---
import SiteWidget from './SiteWidget.astro';
const meta = [['ROLE','UI/UX Designer'],['TIMELINE','Redesign Project'],['TOOLS','Figma'],['CLIENT','Stichting Sportparkbeheer (NL)']];
---
<section aria-label="Project introduction" class="absolute left-0 top-[729px] flex h-[1377px] w-full flex-col items-start px-[120px] py-[100px]">
  <div class="h-[16px] shrink-0 w-px"></div>
  <h1 class="font-ral font-semibold leading-[88px] shrink-0 text-[88px] text-white tracking-[-3.5px] whitespace-nowrap">Stichting Sportpark</h1>
  <div class="h-[24px] shrink-0 w-px"></div>
  <p class="font-ral font-normal leading-[35px] min-w-full shrink-0 text-[#f5f5f5] text-[22px] tracking-[-0.4px] w-[min-content]">A modern homepage for the foundation that manages Sportpark De Ooigraaf in Beuningen: a text-heavy association site turned into a clear, trustworthy routing page for users, partners and residents.</p>
  <div class="h-[48px] shrink-0 w-px"></div>
  <div class="flex h-[57px] items-start justify-between leading-[normal] overflow-clip shrink-0 w-full whitespace-nowrap">
    {meta.map(([k,v]) => (
      <div class="flex flex-col gap-[8px] items-start overflow-clip shrink-0">
        <p class="font-ral font-bold shrink-0 text-[#08a5d8] text-[24px] tracking-[1.3px] uppercase">{k}</p>
        <p class="font-ral font-medium shrink-0 text-[18px] text-white">{v}</p>
      </div>
    ))}
  </div>
  <div class="h-[56px] shrink-0 w-px"></div>
  <SiteWidget />
</section>
