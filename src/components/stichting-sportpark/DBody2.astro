---
import DSection from './DSection.astro';
import DNumCards from './DNumCards.astro';
import Img from '../Img.astro';
import PhoneWidget from './PhoneWidget.astro';
const principles = [
  ['01','Professional, not municipal','Clear hierarchy, white space and consistent cards keep the tone trustworthy without a heavy, official look.'],
  ['02','Red and blue lead','The house red and blue carry buttons, labels and accents. Green and yellow support only specific blocks.'],
  ['03','Introduce, then link','Each section is short and links onward, instead of putting all the content on one page.'],
  ['04','More than a football club','Images and copy cover facilities, users, maintenance and community, not one association.'],
];
const decisions = [
  ['01','A clear promise first','The hero states the role in one line, offers two actions and keeps the navigation to five items.'],
  ['02','Cards before detail','Three focus cards introduce management, users and quality before any long text.'],
  ['03','Proof and a way in','News and the long-term vision build trust, and a photo-led block closes with a clear route to contact.'],
];
const phone = [
  ['COMPSticht_284-1812',0,0,393,67],
  ['COMPSticht_284-1813',16,80,361,638],
  ['COMPSticht_284-1814',0,734,393,2156.719],
  ['COMPSticht_284-1815',16,2906.72,361,916],
  ['COMPSticht_284-1816',0,3838.72,393,1714.2],
  ['COMPSticht_284-1817',0,5568.92,393,2598.719],
  ['COMPSticht_284-1818',0,8183.64,393,1595.8],
  ['COMPSticht_284-1819',16,9795.44,361,1664],
];
---
<DSection top={3054} h={730} eyebrow={'04  /  PRINCIPLES'} eyebrowId="principles" title="PRINCIPLES" statement="Four rules from the brief kept the homepage clear, local and consistent.">
  <DNumCards items={principles} w={282} h={298} />
</DSection>

<DSection top={3784} h={1236} eyebrow={'05  /  MOBILE EXPERIENCE'} title="MOBILE EXPERIENCE" statement="The same homepage in one column: scroll inside the phone to see every section." bg="linear-gradient(8.79688112816477deg, rgb(0, 0, 0) 29.927%, rgb(0, 167, 221) 43.676%, rgb(0, 123, 163) 59.866%, rgb(0, 0, 0) 86.727%)" stripe={68.5714} stripeH={1306}>
  <div class="relative flex shrink-0 items-start gap-[80px]">
    <PhoneWidget />
    <div class="relative flex w-[640px] shrink-0 flex-col items-start gap-[24px]">
      <h3 class="relative top-[2px] w-[640px] shrink-0 font-ral text-[44px] font-semibold leading-[50px] tracking-[-1px] text-white">Homepage</h3>
      <p class="w-[560px] shrink-0 font-ral text-[18px] font-normal leading-[29px] text-[rgba(255,255,255,0.9)]">The same eight sections in one column: hero, focus cards, facilities, users, news, vision and a closing call to action.</p>
      <p class="w-[560px] shrink-0 font-ral text-[14px] font-normal leading-[22px] text-[rgba(255,255,255,0.75)]">Scroll inside the phone. The navigation stays pinned at the top.</p>
    </div>
  </div>
</DSection>

<DSection top={5020} h={1517} eyebrow={'06  /  THE HOMEPAGE'} eyebrowId="homepage" title="THE HOMEPAGE" statement="Each section has one job, from what the foundation does to how to get in touch.">
  <div class="relative h-[811px] w-[1200px] shrink-0 overflow-clip rounded-[16px] border border-solid border-[rgba(255,255,255,0.12)] bg-[#f5f5f5]">
    <Img f="StichtingS_285-1701" class="absolute size-full max-w-none rounded-[16px] object-cover" sizes="1200px" />
  </div>
  <DNumCards items={decisions} w={384} h={242} />
</DSection>
