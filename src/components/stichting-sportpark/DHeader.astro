---
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
---
<div class="absolute left-0 top-0 h-[788px] w-full overflow-clip" style="background-image:linear-gradient(181.90429879160814deg, rgb(2, 2, 2) 8.6024%, rgb(61, 151, 181) 53.887%, rgb(0, 167, 222) 95.891%)">
  <div class="absolute left-0 right-0 top-0 h-[884px]" style="background-image:repeating-linear-gradient(90deg, rgba(0,0,0,.02) 0, rgba(255,255,255,.02) 65.4545px)" aria-hidden="true"></div>
  <header class="absolute flex h-[43px] items-center left-[82px] top-[30px] w-[1277px]">
    <a href="/" aria-label="Home" class="flex h-[22px] w-[140px] shrink-0 flex-col items-start pr-[99px] relative">
      <span class="absolute flex h-[22px] items-center justify-center left-[-5.85px] top-0 w-[38.211px]">
        <span class="-skew-x-28 flex-none scale-y-88">
          <span class="flex gap-[4.257px] items-start relative">
            <span class="bg-[#d5e0e9] h-[24.917px] rounded-br-[2px] rounded-tl-[2px] shrink-0 w-[6px]"></span>
            <span class="bg-[#d5e0e9] h-[24.917px] rounded-br-[2px] rounded-tl-[2px] shrink-0 w-[6px]"></span>
            <span class="bg-[#d5e0e9] h-[24.917px] rounded-br-[2px] rounded-tl-[2px] shrink-0 w-[6px]"></span>
          </span>
        </span>
      </span>
    </a>
    <nav class="flex gap-[31px] items-center relative shrink-0">
      <a href="#overview" class="flex flex-col items-start opacity-95"><p class="font-ral font-medium leading-[18px] text-[#d1dce8] text-[12px] whitespace-nowrap">Overview</p></a>
      <a href="#principles" class="flex flex-col items-start opacity-95"><p class="font-ral font-medium leading-[18px] text-[#d1dce8] text-[12px] whitespace-nowrap">Principles</p></a>
      <a href="#homepage" class="flex flex-col items-start opacity-95"><p class="font-ral font-medium leading-[18px] text-[#d1dce8] text-[12px] whitespace-nowrap">Homepage</p></a>
      <a href="#outcomes" class="flex flex-col items-start opacity-95"><p class="font-ral font-medium leading-[18px] text-[#d1dce8] text-[12px] whitespace-nowrap">Outcomes</p></a>
    </nav>
    <div class="flex flex-[1_0_0] gap-[12px] items-start justify-end min-w-px relative">
      <a href="/Mehroze_UIUX_CV.pdf" target="_blank" rel="noopener" class="group border border-[#08a8dc] border-solid flex gap-[10px] h-[43px] items-center overflow-clip px-[16px] relative rounded-[46px] shrink-0">
        <span class="absolute bg-white bottom-[-1.01px] h-[0.01px] left-[-1px] right-[-1px] transition-[height] duration-300 ease-out group-hover:h-[calc(100%+2px)]"></span>
        <p class="font-ral font-semibold leading-[16.5px] relative shrink-0 text-[#08a8dc] text-[14px] whitespace-nowrap">View CV</p>
        <span class="relative shrink-0 size-[16px]"><Arrow c="#08a8dc" /></span>
      </a>
      <a href="https://www.linkedin.com/in/muhammadmehrozemaqsood/" target="_blank" rel="noopener" class="bg-[#08a8dc] cursor-pointer flex gap-[10px] h-[43px] items-center overflow-clip pl-[13px] pr-[6px] relative rounded-[46px] shrink-0">
        <p class="font-ral font-semibold leading-[16.5px] relative shrink-0 text-[14px] text-black whitespace-nowrap">Connect Now</p>
        <span class="border border-black border-solid grid place-items-center relative rounded-[41px] shrink-0 size-[32px]" style="background-image:linear-gradient(90deg, rgb(0, 0, 0) 0%, rgb(0, 0, 0) 100%), linear-gradient(90deg, rgb(11, 168, 219) 0%, rgb(11, 168, 219) 100%)"><Arrow c="#0ba8db" /></span>
      </a>
    </div>
  </header>
  <p aria-hidden="true" class="-translate-x-1/2 absolute bg-clip-text font-utara font-semibold leading-[normal] left-[722.5px] not-italic text-[171px] text-[transparent] text-center top-[137px] tracking-[-1.16px] whitespace-nowrap" style="background-image:linear-gradient(180.73736031993167deg, rgb(2, 2, 2) 8.6024%, rgb(61, 151, 181) 53.887%, rgb(0, 167, 222) 95.891%), linear-gradient(0.2628779857005128deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(170.26057796740895deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%), linear-gradient(90deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100%);-webkit-background-clip:text;background-clip:text">SPORTPARK</p>
  <div class="absolute h-[909px] left-0 top-[116px] w-[1214px]"><Img f="StichtingS_124-1953" class="absolute inset-0 size-full max-w-none object-cover" sizes="1214px" eager /></div>
</div>
