---
import Img from '../Img.astro';
const phone = [
  ['COMPSticht_284-1812',0,0,393,67],
  ['COMPSticht_284-1813',16,80,361,638],
  ['COMPSticht_284-1814',0,734,393,2156.719],
  ['COMPSticht_284-1815',16,2906.72,361,916],
  ['COMPSticht_284-1816',0,3838.72,393,1714.2],
  ['COMPSticht_284-1817',0,5568.92,393,2598.719],
  ['COMPSticht_284-1818',0,8183.64,393,1595.8],
  ['COMPSticht_284-1819',16,9795.44,361,1664],
];
---
    <div class="relative h-[804px] w-[417px] shrink-0 rounded-[56px] bg-[#15151a]">
      <div class="absolute left-[12px] top-[12px] h-[780px] w-[393px] overflow-clip rounded-[44px] bg-white">
        <div class="stv absolute left-0 top-0 h-[780px] w-[393px] overflow-x-clip overflow-y-auto bg-[#f5f5f5]" style="scrollbar-width:none">
          <div class="relative h-[11459.438px] w-[393px] bg-[#f5f5f5]">
            {phone.map(([k,l,t,w,h]) => (
              <div class="absolute bg-[#f5f5f5] overflow-clip" style={`left:${l}px;top:${t}px;width:${w}px;height:${h}px`}>
                <Img f={k} class="absolute size-full max-w-none object-cover" sizes="393px" />
              </div>
            ))}
          </div>
        </div>
        <div class="pointer-events-none absolute left-0 top-0 h-[64px] w-[393px] overflow-clip bg-[#f5f5f5]">
          <Img f="COMPSticht_284-1812" class="absolute size-full max-w-none object-cover" sizes="393px" />
        </div>
      </div>
    </div>
