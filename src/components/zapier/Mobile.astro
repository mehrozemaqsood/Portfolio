---
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
import BgLines from '../boltshift/BgLines.astro';
import BrowserD from './BrowserD.astro';
import PhoneD from './PhoneD.astro';
import { k } from './keys';

const glance = [
  ['2', 'Themes', 'Light and dark'], ['2', 'Breakpoints', 'Desktop and mobile'], ['12', 'Page sections', 'Hero to closing CTA'],
  ['4', 'Animated carousels', 'Looping marquee rows'], ['1', 'Landing page', 'One long scroll'],
];
const meta = [['ROLE', 'UI/UX Designer'], ['TIMELINE', 'Concept Project'], ['TOOLS', 'Figma'], ['CLIENT', 'Zapier (concept)']];
const goals = [
  ['01', 'One clear promise', 'The hero states “Your tools. Your rules. Any AI.” and puts two sign-up paths and three proof numbers directly under it.', '#ffbd9f'],
  ['02', 'Show, don’t describe', 'Integration tiles, an MCP and SDK diagram and product screens explain the platform visually before any long copy.'],
  ['03', 'Proof and control', 'Customer results, a large task counter and a governance and security section answer the question “can we trust it?”'],
];
const brief = [
  ['The brief', 'Design a landing page that explains Zapier’s AI automation, its MCP and SDK offering and its enterprise governance, in the existing Zapier look, with light and dark themes.', 130],
  ['My role', 'UI/UX designer. I designed the desktop landing page in both themes, the mobile layout and the animated carousels.', 104],
  ['Scope', 'Desktop landing page in light and dark, a mobile version of both, and looping carousel components.', 78],
];
const flow = [
  ['PAGE  /  HERO', 108, 2972, 'h-[113.85%] left-0 top-0 w-full', '#fffefb', 'Promise first', 'A headline, two sign-up buttons and three usage numbers open the page, with a tile picker for Claude, ChatGPT, Cursor and more below.', 104],
  ['PAGE  /  FEATURES', 164, 2970, 'h-[277.76%] left-0 top-[-18.05%] w-full', '#fffefb', 'A system, not a tool list', '“Every team has AI. Now they need a System.” opens a grid of feature cards with product previews and clear calls to action.', 78],
  ['PAGE  /  DIAGRAM', 106, 2969, 'h-[249.05%] left-0 top-[-10.19%] w-full', '#fffefb', 'One diagram, one connection', 'Zapier MCP and SDK are shown as one secure connection for every AI surface, followed by four short proof points.', 78],
  ['PAGE  /  RESULTS', 130, 2965, 'h-[285.83%] left-0 top-0 w-full', '#0f0f0f', 'Results as a number', 'A large task counter, a growth chart and four short claims replace paragraphs of copy in the dark results band.', 78],
];
const principles = [
  ['01', 'One clear promise', 'The first screen says what Zapier does in one line and offers two ways to start.'],
  ['02', 'Show, don’t describe', 'Tiles, diagrams and product screens carry the story, so the paragraphs can stay short.'],
  ['03', 'Proof in the flow', 'Numbers, a customer story and real templates sit between the claims, not on a separate page.'],
  ['04', 'Two themes, one system', 'Light and dark share the same layout, spacing and components. Only the colour tokens change.'],
];
const decisions = [
  ['01', 'Same structure', 'Dark mode keeps every section, its order and its spacing from the light page.'],
  ['02', 'Orange stays the accent', 'Buttons, key words and numbers keep the Zapier orange, so the brand reads the same in both themes.'],
  ['03', 'Surfaces change', 'Cream backgrounds become near-black, and cards, dividers and diagrams are re-toned to match.'],
];
const wall = [[1786, false, 'Light  /  Features'], [1789, true, 'Dark  /  Features'], [1792, false, 'Light  /  Diagram'], [1795, true, 'Dark  /  Diagram']];
const photos = [
  [1803, false, 'Toolkit'], [1806, false, 'Customer story'], [1809, true, 'Results counter'], [1812, true, 'Webinar promo'],
  [1815, false, 'Real outcomes'], [1818, false, 'Governance'], [1821, false, 'Security'],
];
const palette = [
  ['Orange', '#FF4F00', 'Accent', 20], ['Ink', '#201515', 'Text and dark sections', 32], ['Cream', '#F8F4F0', 'Page background', 16],
  ['Paper', '#FFFEFB', 'Cards and hero', 16], ['Stone', '#ECEAE3', 'Lines and fills', 16], ['Olive', '#32372C', 'Feature band', 16],
];
const outcomes = [
  ['01', 'Information design', 'Twelve sections move from promise to proof to security without long copy.'],
  ['02', 'Design systems', 'One set of tokens drives light and dark, so the two themes stay in step.'],
  ['03', 'Responsive design', 'A single-column mobile layout keeps the same order in both themes.'],
  ['04', 'Motion', 'Looping carousels add life to logo and use-case rows without hiding content.'],
];

const sec = 'relative flex w-full flex-col items-start gap-[32px] px-[20px] py-[56px]';
const eyebrow = 'h-[16px] w-full whitespace-pre font-ral text-[14px] font-bold leading-[normal] tracking-[2px] text-[#ff4f00]';
const title = 'h-[44px] w-full whitespace-nowrap font-ral text-[42px] font-semibold leading-[44px] tracking-[-1.25px] text-white';
const lead = 'w-full font-ral text-[30px] font-semibold leading-[40px] text-white';
const body = 'w-full font-ral text-[17px] font-normal leading-[28px] text-white';
const card = 'flex w-full shrink-0 flex-col items-start gap-[16px] rounded-[16px] border border-solid border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.04)] p-[32px]';
const num = 'h-[36px] w-full font-ral text-[22px] font-semibold leading-[36px] tracking-[-2px] text-[rgba(255,79,0,0.9)]';
const ct = 'h-[30px] w-full font-ral text-[22px] font-semibold leading-[30px] text-white';
const ct11 = 'h-[15px] w-full whitespace-nowrap font-ral text-[11px] font-semibold leading-[15px] text-white';
const cd = 'w-full font-ral text-[16px] font-normal leading-[26px] text-[#9e9ea6]';
const Hh = (n) => `height:${n}px`;
const thumb = 'relative h-[101.858px] w-[167px] shrink-0 rounded-[5.922px]';
const lk = 'block font-ral text-[16px] font-medium text-[rgba(255,255,255,0.85)]';
const orange = 'linear-gradient(26.813634596676096deg, rgb(0, 0, 0) 29.532%, rgb(255, 126, 67) 43.987%, rgb(166, 51, 0) 57.428%, rgb(0, 0, 0) 82.454%)';
const grad2 = (a, b, c, d) => `background-image:linear-gradient(${a}deg, rgb(0, 0, 0) 29.532%, rgb(255, 126, 67) 43.987%, rgb(166, 51, 0) 57.428%, rgb(0, 0, 0) 82.454%), linear-gradient(${b}deg, rgb(0, 0, 0) 37.573%, rgb(122, 145, 246) 51.604%, rgb(49, 71, 166) 64.714%, rgb(0, 0, 0) 89.063%)`;
---
<div class="relative h-[15859px] w-full overflow-clip bg-[#020202]">
  <!-- Header band -->
  <section aria-label="Zapier hero art" class="absolute left-0 top-0 h-[670px] w-full overflow-clip bg-black">
    <div class="absolute left-0 top-[110px] h-[560px] w-[390px]"><Img f="ZapierMob_406-4070" alt="" class="absolute inset-0 size-full max-w-none object-cover" sizes="390px" eager /></div>
    <header class="absolute left-[20px] top-[24px] flex h-[43px] w-[350px] items-center justify-between">
      <div class="relative flex h-[22px] w-[140px] shrink-0 flex-col items-start pr-[99px]">
        <a href="/" aria-label="Home" class="absolute left-[-5.85px] top-0 flex h-[22px] w-[38.211px] items-center justify-center">
          <div class="flex-none -skew-x-[28deg] scale-y-[0.88]">
            <div class="relative flex cursor-pointer items-start gap-[4.257px]">
              <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></span>
              <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></span>
              <span class="block h-[24.917px] w-[6px] shrink-0 rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></span>
            </div>
          </div>
        </a>
      </div>
      <div class="flex w-[204px] shrink-0 items-start justify-end gap-[10px]">
        <a href="/Mehroze_UIUX_CV.pdf" target="_blank" rel="noopener" class="group relative flex h-[43px] shrink-0 items-center gap-[10px] overflow-clip rounded-[46px] border border-solid border-white px-[16px]">
          <span class="absolute bottom-[-1.01px] left-[-1px] right-[-1px] h-[0.01px] bg-white transition-[height] duration-300 ease-out group-hover:h-[calc(100%+2px)]"></span>
          <p class="relative shrink-0 font-ral text-[14px] font-semibold leading-[16.5px] text-white transition-colors duration-300 whitespace-nowrap group-hover:text-[#020202]">View CV</p>
          <span class="relative block size-[16px] shrink-0"><svg class="block size-full transition-colors duration-300" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.6665 4.6665H11.3332V11.3332" stroke="currentColor" stroke-width="0.866667" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.6665 11.3332L11.3332 4.6665" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </header>
    <p aria-hidden="true" class="absolute left-[195px] top-[100px] -translate-x-1/2 bg-clip-text font-utara text-[100.419px] font-semibold not-italic leading-[normal] tracking-[-0.6812px] text-[transparent] text-center whitespace-nowrap" style="background-image:linear-gradient(2.3804231996128067deg, rgb(255, 255, 255) 27.446%, rgb(166, 166, 166) 47.541%, rgb(2, 2, 2) 85.498%), linear-gradient(181.25560779324613deg, rgb(2, 2, 2) 8.6024%, rgb(61, 151, 181) 53.887%, rgb(0, 167, 222) 95.891%), linear-gradient(0.44768054412331537deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(163.70589927650008deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%), linear-gradient(90deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100%);-webkit-background-clip:text;background-clip:text">ZAPIER</p>
    <div class="pointer-events-none absolute left-0 top-[110px] h-[560px] w-[390px]"><Img f="ZapierMob_406-4100" alt="Zapier landing page on a laptop" class="absolute inset-0 size-full max-w-none object-cover" sizes="390px" eager /></div>
  </section>

  <!-- Hero -->
  <section aria-label="Project summary" class="absolute left-0 top-[611px] flex h-[966.33px] w-full flex-col items-start px-[20px] py-[100px]">
    <div class="h-[16px] w-px shrink-0"></div>
    <h1 class="h-[44px] whitespace-nowrap font-ral text-[44px] font-semibold leading-[44px] tracking-[-1.75px] text-white">Zapier</h1>
    <div class="h-[24px] w-px shrink-0"></div>
    <p class="h-[210px] w-full font-ral text-[22px] font-normal leading-[35px] tracking-[-0.4px] text-[#f5f5f5]">A landing page concept for Zapier’s AI story: one clear promise, real proof and a governed path from first automation to enterprise scale, designed in light and dark, on desktop and mobile.</p>
    <div class="h-[48px] w-px shrink-0"></div>
    <div class="flex h-[130px] w-full shrink-0 flex-wrap content-start items-start justify-between gap-y-[16px] overflow-clip leading-[normal]">
      {meta.map(([a, b]) => (
        <div class="flex w-[167px] shrink-0 flex-col items-start gap-[8px] overflow-clip">
          <p class="h-[28px] w-full font-ral text-[24px] font-bold uppercase tracking-[1.3px] text-[#ff4f00]">{a}</p>
          <p class="h-[21px] w-full font-ral text-[18px] font-medium text-white">{b}</p>
        </div>
      ))}
    </div>
    <div class="h-[56px] w-px shrink-0"></div>
    <div class="h-[238.3px] w-[350px] shrink-0 overflow-clip"><BrowserD s={0.2916667} /></div>
  </section>

  <!-- Body -->
  <div class="absolute left-0 top-[1534.33px] w-full" style="isolation:isolate">
    <section aria-label="At a glance" class="flex h-[483px] w-full flex-wrap content-start items-start gap-x-[20px] gap-y-[20px] bg-[#020202] px-[20px] pb-[32px] pt-[48px]">
      {glance.map(([n, t, s]) => (
        <div class="flex w-[165px] shrink-0 flex-col items-start gap-[8px] overflow-clip">
          <p class="h-[68px] w-full font-ral text-[64px] font-semibold leading-[68px] tracking-[-2px] text-white">{n}</p>
          <p class="h-[21px] w-full font-ral text-[18px] font-semibold leading-[normal] text-white">{t}</p>
          <p class="h-[16px] w-full font-ral text-[14px] font-normal leading-[normal] text-[#9e9ea6]">{s}</p>
        </div>
      ))}
    </section>

    <section id="overview-m" aria-label="Overview" class="relative flex w-full flex-col items-start gap-[32px] px-[20px] pb-[56px] pt-[32px]" style="background-image:linear-gradient(27.600216346092644deg, rgb(0, 0, 0) 37.573%, rgb(255, 79, 0) 51.637%, rgb(121, 38, 0) 64.714%, rgb(0, 0, 0) 89.063%), linear-gradient(90deg, rgb(2, 2, 2) 0%, rgb(2, 2, 2) 100%)">
      <p class={eyebrow}>{'01  /  OVERVIEW'}</p>
      <h2 class={title}>OVERVIEW</h2>
      <p class={lead} style={Hh(120)}>An AI automation page should sell control, not just capability.</p>
      <p class={body} style={Hh(168)}>Zapier’s page has to speak to builders who want MCP and SDK access and to leaders who need governance. This concept sets out one long page that leads with a single promise, shows the product doing real work, and closes with security and scale.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {goals.map(([n, t, d, c]) => (<div class={card} style={Hh(268)}><p class={num} style={c ? `color:${c}` : undefined}>{n}</p><h3 class={ct}>{t}</h3><p class={cd} style={c ? `${Hh(104)};color:#fff` : Hh(104)}>{d}</p></div>))}
      </div>
    </section>

    <section aria-label="Brief and role" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'02  /  BRIEF AND ROLE'}</p>
      <h2 class={title}>BRIEF AND ROLE</h2>
      <p class={lead} style={Hh(160)}>The brief: present Zapier’s AI platform to builders and to business leaders on one page.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {brief.map(([t, d, h]) => (<div class={card}><h3 class={ct}>{t}</h3><p class={cd} style={Hh(h)}>{d}</p></div>))}
      </div>
      <p class="h-[72px] w-full font-ral text-[15px] font-normal leading-[24px] text-[#9e9ea6]">This is a design case study. Product names, copy and numbers come from Zapier’s public messaging.</p>
    </section>

    <section aria-label="The page flow" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'03  /  THE PAGE FLOW'}</p>
      <h2 class={title}>THE PAGE FLOW</h2>
      <p class={lead} style={Hh(120)}>One long page, ordered from promise to proof to trust.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {flow.map(([lab, cw, n, ic, bg, t, d, h]) => (
          <div class="flex w-full shrink-0 flex-col items-start gap-[16px]">
            <div class="relative flex h-[280px] w-full shrink-0 flex-col items-center justify-center overflow-clip rounded-[16px] border border-dashed border-[rgba(255,255,255,0.25)] bg-[rgba(255,255,255,0.03)]">
              <div class="absolute left-[-1px] top-[-1px] h-[280px] w-[588px] rounded-[16px]">
                <div class="pointer-events-none absolute inset-0 rounded-[16px]" style={`background:${bg}`}></div>
                <div class="absolute inset-0 overflow-hidden rounded-[16px]"><Img f={k(n)} class={`absolute max-w-none ${ic}`} sizes="588px" alt="" /></div>
              </div>
              <div class="absolute left-[5px] top-[5px] h-[21px] rounded-[5px] bg-[rgba(2,2,2,0.88)]" style={`width:${cw}px`}></div>
              <p class="absolute left-[11px] top-[10px] font-ral text-[9px] font-bold leading-[normal] tracking-[1.5px] text-[#9e9ea6] whitespace-pre">{lab}</p>
            </div>
            <h3 class={ct}>{t}</h3>
            <p class={cd} style={Hh(h)}>{d}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="principles-m" aria-label="Principles" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'04  /  PRINCIPLES'}</p>
      <h2 class={title}>PRINCIPLES</h2>
      <p class={lead} style={Hh(120)}>Four rules kept a dense AI product page clear and easy to scan.</p>
      <div class="flex w-full shrink-0 flex-col items-start gap-[16px]">
        {principles.map(([n, t, d]) => (<div class={card}><p class={num}>{n}</p><h3 class={ct}>{t}</h3><p class={cd} style={Hh(78)}>{d}</p></div>))}
      </div>
    </section>

    <section aria-label="Mobile experience" class={`${sec} overflow-clip`} style={grad2(26.813634596676096, 22.066917934321467)}>
      <BgLines top={2.5} h={1306} w={68.5714} />
      <p class={eyebrow}>{'05  /  MOBILE EXPERIENCE'}</p>
      <h2 class="h-[39px] w-full whitespace-nowrap font-ral text-[36.476px] font-semibold leading-[38.213px] tracking-[-1.0856px] text-white">MOBILE EXPERIENCE</h2>
      <p class={lead} style={Hh(160)}>The same page in one column: scroll inside the phone and switch between light and dark.</p>
      <div class="relative h-[675px] w-full shrink-0 overflow-clip"><div style="zoom:0.8393"><PhoneD /></div></div>
    </section>

    <section id="dark-mode-m" aria-label="Dark mode" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'06  /  DARK MODE'}</p>
      <h2 class={title}>DARK MODE</h2>
      <p class={lead} style={Hh(120)}>Every section has a dark twin: the same layout with different tokens.</p>
      <div class="relative h-[236.542px] w-[350px] shrink-0 rounded-[4.667px] border-[0.292px] border-solid border-[rgba(255,255,255,0.12)] bg-[#0f0f0f]">
        <div class="absolute inset-0 overflow-hidden rounded-[4.667px]"><Img f="ZapierCase_289-1742" alt="Dark mode version of the Zapier landing page hero" class="absolute left-[-12.33%] top-0 h-full w-[124.66%] max-w-none" sizes="440px" /></div>
      </div>
      <div class="flex w-full shrink-0 flex-col items-start gap-[24px]">
        {decisions.map(([n, t, d]) => (<div class={card} style={Hh(242)}><p class={num}>{n}</p><h3 class={ct}>{t}</h3><p class={cd} style={Hh(78)}>{d}</p></div>))}
      </div>
    </section>

    <section aria-label="Light and dark" class={`${sec} overflow-clip`} style={grad2(18.04448883938609, 10.095063147419339)}>
      <BgLines top={1} h={2920} />
      <p class={eyebrow}>{'07  /  LIGHT AND DARK'}</p>
      <h2 class={title}>LIGHT AND DARK</h2>
      <p class={lead} style={Hh(120)}>The same sections in both themes, side by side.</p>
      <p class="h-[16px] w-full whitespace-pre font-ral text-[14px] font-bold leading-[normal] tracking-[2px] text-[#f5f5f5]">{'DESKTOP  /  LIGHT AND DARK'}</p>
      <div class="flex w-full shrink-0 flex-wrap content-start items-start gap-[16px]">
        {wall.map(([n, dk, lab]) => (
          <div class="flex w-[167px] shrink-0 flex-col items-start gap-[10px]">
            <div class={`${thumb} border-[0.592px] border-solid border-[rgba(255,255,255,0.12)]`} style={`background:${dk ? '#0f0f0f' : '#fffefb'}`}><div class="absolute inset-0 overflow-hidden rounded-[5.922px]"><Img f={k(n)} class="absolute size-full max-w-none object-cover" sizes="167px" alt="" /></div></div>
            <p class="h-[16px] w-full whitespace-pre font-ral text-[14px] font-medium leading-[normal] text-white">{lab}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-label="Every section" class={`${sec} bg-[#020202]`}>
      <p class={eyebrow}>{'08  /  EVERY SECTION'}</p>
      <h2 class={title}>EVERY SECTION</h2>
      <p class={lead} style={Hh(120)}>From the toolkit to the closing call to action, each block has one job.</p>
      <div class="flex w-full shrink-0 flex-wrap content-start items-start gap-[16px]">
        {photos.map(([n, dk, lab]) => (
          <div class="flex w-[167px] shrink-0 flex-col items-start gap-[10px]">
            <div class={`${thumb} border-[0.592px] border-solid border-[rgba(255,255,255,0.12)]`} style={`background:${dk ? '#0f0f0f' : '#fffefb'}`}><div class="absolute inset-0 overflow-hidden rounded-[5.922px]"><Img f={k(n)} class="absolute size-full max-w-none object-cover" sizes="167px" alt="" /></div></div>
            <p class="h-[16px] w-full whitespace-nowrap font-ral text-[14px] font-medium leading-[normal] text-white">{lab}</p>
          </div>
        ))}
        <div class="flex w-[167px] shrink-0 flex-col items-start gap-[10px]">
          <div class={`${thumb} border-[0.592px] border-solid border-[rgba(255,255,255,0.12)] bg-[#0f0f0f]`}><div class="absolute inset-0 overflow-hidden rounded-[5.922px]"><Img f="ZapierCase_289-2961" class="absolute size-full max-w-none object-contain" sizes="167px" alt="" /></div></div>
          <p class="h-[16px] w-full whitespace-nowrap font-ral text-[14px] font-medium leading-[normal] text-white">Closing CTA</p>
        </div>
      </div>
    </section>

    <section aria-label="Brand style" class={`${sec} overflow-clip`} style={grad2(34.98015711843772, 20.92596399995861)}>
      <BgLines top={0.5} h={2146} />
      <p class={eyebrow}>{'09  /  BRAND STYLE'}</p>
      <h2 class={title}>BRAND STYLE</h2>
      <p class={lead} style={Hh(160)}>Zapier orange on warm neutrals, with a near-black ground for dark mode.</p>
      <div class="flex w-full shrink-0 flex-wrap content-start items-start gap-[16px] overflow-clip">
        {palette.map(([n, hex, d, h], i) => (
          <div class={`flex flex-col items-start gap-[10px] rounded-[16px] border border-solid border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.04)] p-[16px] ${i < 4 ? 'w-[167px] shrink-0' : 'min-w-px flex-[1_0_0]'}`}>
            <div class="h-[120px] w-full shrink-0 rounded-[10px] border border-solid border-[rgba(255,255,255,0.15)]" style={`background:${hex}`}></div>
            <p class="h-[23px] w-full font-ral text-[20px] font-semibold leading-[normal] text-white">{n}</p>
            <p class="h-[16px] w-full font-ral text-[14px] font-medium leading-[normal] text-[#d9d9e0]">{hex}</p>
            <p class="w-full font-ral text-[14px] font-normal leading-[normal] text-[#d9d9e0]" style={Hh(h === 32 ? 32 : 16)}>{d}</p>
          </div>
        ))}
      </div>
      <div class="flex w-full shrink-0 flex-col items-start gap-[32px] rounded-[16px] border border-solid border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.04)] px-[40px] py-[32px] leading-[normal]">
        <p class="h-[85px] w-[134px] font-inter text-[70px] font-semibold not-italic text-white" aria-hidden="true">Aa</p>
        <div class="flex w-full shrink-0 flex-col items-start gap-[10px] overflow-clip">
          <p class="h-[26px] w-full font-ral text-[22px] font-semibold text-white">Inter</p>
          <p class="h-[76px] w-full font-ral text-[16px] font-normal text-[#9e9ea6]">Body text, navigation, buttons and labels. Headlines on the page use Degular Display, with Serrif for customer quotes.</p>
