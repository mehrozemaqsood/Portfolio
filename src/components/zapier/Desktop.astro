---
import Img from '../Img.astro';
import FloatingBar from '../FloatingBar.astro';
import BrowserD from './BrowserD.astro';
import PhoneD from './PhoneD.astro';
import { k } from './keys';

const stats = [
  ['2', 'Themes', 'Light and dark'], ['2', 'Breakpoints', 'Desktop and mobile'], ['12', 'Page sections', 'Hero to closing CTA'],
  ['4', 'Animated carousels', 'Looping marquee rows'], ['1', 'Landing page', 'One long scroll'],
];
const goals = [
  ['01', 'One clear promise', 'The hero states “Your tools. Your rules. Any AI.” and puts two sign-up paths and three proof numbers directly under it.'],
  ['02', 'Show, don’t describe', 'Integration tiles, an MCP and SDK diagram and product screens explain the platform visually before any long copy.'],
  ['03', 'Proof and control', 'Customer results, a large task counter and a governance and security section answer the question “can we trust it?”'],
];
const brief = [
  ['The brief', 'Design a landing page that explains Zapier’s AI automation, its MCP and SDK offering and its enterprise governance, in the existing Zapier look, with light and dark themes.'],
  ['My role', 'UI/UX designer. I designed the desktop landing page in both themes, the mobile layout and the animated carousels.'],
  ['Scope', 'Desktop landing page in light and dark, a mobile version of both, and looping carousel components.'],
];
// [label, label chip width, key node, img classes, bg, title, text]
const flow = [
  ['PAGE  /  HERO', 108, 2972, 'h-[113.85%] left-0 top-0 w-full', '#fffefb', 'Promise first', 'A headline, two sign-up buttons and three usage numbers open the page, with a tile picker for Claude, ChatGPT, Cursor and more below.'],
  ['PAGE  /  FEATURES', 164, 2970, 'h-[277.76%] left-0 top-[-18.05%] w-full', '#fffefb', 'A system, not a tool list', '“Every team has AI. Now they need a System.” opens a grid of feature cards with product previews and clear calls to action.'],
  ['PAGE  /  DIAGRAM', 106, 2969, 'h-[249.05%] left-0 top-[-10.19%] w-full', '#fffefb', 'One diagram, one connection', 'Zapier MCP and SDK are shown as one secure connection for every AI surface, followed by four short proof points.'],
  ['PAGE  /  RESULTS', 130, 2965, 'h-[285.83%] left-0 top-0 w-full', '#0f0f0f', 'Results as a number', 'A large task counter, a growth chart and four short claims replace paragraphs of copy in the dark results band.'],
];
const principles = [
  ['01', 'One clear promise', 'The first screen says what Zapier does in one line and offers two ways to start.'],
  ['02', 'Show, don’t describe', 'Tiles, diagrams and product screens carry the story, so the paragraphs can stay short.'],
  ['03', 'Proof in the flow', 'Numbers, a customer story and real templates sit between the claims, not on a separate page.'],
  ['04', 'Two themes, one system', 'Light and dark share the same layout, spacing and components. Only the colour tokens change.'],
];
const decisions = [
  ['01', 'Same structure', 'Dark mode keeps every section, its order and its spacing from the light page.'],
  ['02', 'Orange stays the accent', 'Buttons, key words and numbers keep the Zapier orange, so the brand reads the same in both themes.'],
  ['03', 'Surfaces change', 'Cream backgrounds become near-black, and cards, dividers and diagrams are re-toned to match.'],
];
// thumbs: [node, dark?, label, img classes]
const wall = [
  [1786, false, 'Light  /  Features'], [1789, true, 'Dark  /  Features'], [1792, false, 'Light  /  Diagram'], [1795, true, 'Dark  /  Diagram'],
];
const photos = [
  [1803, false, 'Toolkit'], [1806, false, 'Customer story'], [1809, true, 'Results counter'], [1812, true, 'Webinar promo'],
  [1815, false, 'Real outcomes'], [1818, false, 'Governance'], [1821, false, 'Security'],
];
const palette = [
  ['Orange', '#FF4F00', 'Accent'], ['Ink', '#201515', 'Text and dark sections'], ['Cream', '#F8F4F0', 'Page background'], ['Paper', '#FFFEFB', 'Cards and hero'],
  ['Stone', '#ECEAE3', 'Lines and fills'], ['Olive', '#32372C', 'Feature band'],
];
const outcomes = [
  ['01', 'Information design', 'Twelve sections move from promise to proof to security without long copy.'],
  ['02', 'Design systems', 'One set of tokens drives light and dark, so the two themes stay in step.'],
  ['03', 'Responsive design', 'A single-column mobile layout keeps the same order in both themes.'],
  ['04', 'Motion', 'Looping carousels add life to logo and use-case rows without hiding content.'],
];
const stripesM = 'repeating-linear-gradient(90deg, rgba(255,255,255,.02) 0, rgba(0,0,0,.02) 68.5714px)';
const stripes = 'repeating-linear-gradient(90deg, rgba(255,255,255,.02) 0, rgba(0,0,0,.02) 65.4545px)';
const card = 'relative flex shrink-0 flex-col items-start gap-[16px] rounded-[16px] border border-solid border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.04)] p-[32px]';
const eyebrow = 'font-ral text-[14px] font-bold leading-[normal] tracking-[2px] text-[#ff4f00] whitespace-pre';
const title = 'font-ral text-[84px] font-semibold leading-[88px] tracking-[-2.5px] text-white whitespace-nowrap';
const statement = 'w-[1162px] font-ral text-[30px] font-semibold leading-[40px] text-white';
const num = 'font-ral text-[32px] font-semibold leading-[36px] tracking-[-2px] text-[rgba(255,79,0,0.9)] whitespace-nowrap';
const ctitle = 'min-w-full font-ral text-[22px] font-semibold leading-[30px] text-white';
const ctext = 'min-w-full font-ral text-[16px] font-normal leading-[26px] text-[#9e9ea6]';
const sec = 'flex flex-col items-start gap-[32px] overflow-clip px-[120px] py-[96px]';
---
<div class="relative h-[12456px] w-full overflow-clip bg-[#020202]">
  <!-- Header band -->
  <header class="absolute left-0 top-0 h-[788px] w-full overflow-clip" style="background-image:linear-gradient(181.90429879160814deg, rgb(2, 2, 2) 8.6024%, rgb(61, 151, 181) 53.887%, rgb(0, 167, 222) 95.891%)">
    <div class="absolute left-0 top-0 h-[1078px] w-[1440px]"><Img f="PortfolioH_137-2431" class="absolute inset-0 size-full max-w-none object-cover" sizes="1440px" eager /></div>
    <div class="absolute left-[82px] top-[30px] flex w-[1277px] items-center">
      <a href="/" aria-label="Home" class="relative flex h-[22px] w-[140px] shrink-0 flex-col items-start pr-[99px]">
        <div class="absolute left-[-5.85px] top-0 flex h-[22px] w-[38.211px] items-center justify-center">
          <div class="-skew-x-28 flex-none scale-y-88">
            <div class="flex items-start gap-[4.257px]">
              <div class="h-[24.917px] w-[6px] rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></div>
              <div class="h-[24.917px] w-[6px] rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></div>
              <div class="h-[24.917px] w-[6px] rounded-br-[2px] rounded-tl-[2px] bg-[#d5e0e9]"></div>
            </div>
          </div>
        </div>
      </a>
      <nav class="flex shrink-0 items-center gap-[31px]">
        <a href="/boltshift" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">BoltShift</p></a>
        <a href="/lensesonline" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">LensesOnline</p></a>
        <a href="/stichting-sportpark" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Stichting Sportpark</p></a>
        <a href="/zapier" aria-current="page" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-white whitespace-nowrap">Zapier</p></a>
        <a href="/visual-design" class="flex shrink-0 flex-col items-start opacity-95"><p class="font-ral text-[12px] font-medium leading-[18px] text-[#d1dce8] whitespace-nowrap">Visual Design</p></a>
      </nav>
      <div class="flex min-w-px flex-[1_0_0] items-start justify-end gap-[12px]">
        <a href="/Mehroze_UIUX_CV.pdf" target="_blank" rel="noopener" class="group relative flex h-[43px] shrink-0 items-center gap-[10px] overflow-clip rounded-[46px] border border-solid border-white px-[16px]">
          <span class="absolute bottom-[-1.01px] left-[-1px] right-[-1px] h-[0.01px] bg-white transition-[height] duration-300 ease-out group-hover:h-[calc(100%+2px)]"></span>
          <p class="relative shrink-0 font-ral text-[14px] font-semibold leading-[16.5px] text-white transition-colors duration-300 whitespace-nowrap group-hover:text-[#020202]">View CV</p>
          <span class="relative block size-[16px] shrink-0"><svg class="block size-full transition-colors duration-300" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.6665 4.6665H11.3332V11.3332" stroke="currentColor" stroke-width="0.866667" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.6665 11.3332L11.3332 4.6665" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </div>
    <p class="-translate-x-1/2 absolute left-[722px] top-[137px] bg-clip-text text-center font-utara text-[171px] font-semibold not-italic leading-[normal] tracking-[-1.16px] text-[transparent] whitespace-nowrap" style="background-image:linear-gradient(2.380423141756708deg, rgb(255, 255, 255) 27.446%, rgb(166, 166, 166) 47.541%, rgb(2, 2, 2) 85.498%), linear-gradient(181.25560776270328deg, rgb(2, 2, 2) 8.6024%, rgb(61, 151, 181) 53.887%, rgb(0, 167, 222) 95.891%), linear-gradient(0.4476805332303684deg, rgb(132, 153, 248) 35.174%, rgb(65, 85, 172) 56.89%, rgb(0, 0, 0) 97.909%), linear-gradient(163.70589965194966deg, rgb(154, 173, 255) 41.031%, rgb(38, 49, 101) 85.491%, rgb(0, 0, 0) 129.58%), linear-gradient(90deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100%);-webkit-background-clip:text;background-clip:text" aria-hidden="true">ZAPIER</p>
    <div class="absolute left-0 top-0 h-[1078px] w-[1440px]"><Img f="ZapierCase_137-2520" class="absolute inset-0 size-full max-w-none object-cover" sizes="1440px" eager /></div>
  </header>

  <!-- Hero -->
  <section aria-label="Project summary" class="absolute left-0 top-[729px] h-[1377px] w-full overflow-clip px-[120px]">
    <h1 class="absolute left-[120px] top-[116px] font-ral text-[88px] font-semibold leading-[88px] tracking-[-3.5px] text-white whitespace-nowrap">Zapier</h1>
    <p class="absolute left-[120px] top-[228px] w-[1200px] font-ral text-[22px] font-normal leading-[35px] tracking-[-0.4px] text-[#f5f5f5]">A landing page concept for Zapier’s AI story: one clear promise, real proof and a governed path from first automation to enterprise scale, designed in light and dark, on desktop and mobile.</p>
    <div class="absolute left-[120px] top-[346px] flex h-[57px] w-[1200px] items-start justify-between overflow-clip whitespace-nowrap leading-[normal]">
      {[['ROLE', 'UI/UX Designer'], ['TIMELINE', 'Concept Project'], ['TOOLS', 'Figma'], ['CLIENT', 'Zapier (concept)']].map(([a, b]) => (
        <div class="flex shrink-0 flex-col items-start gap-[8px] overflow-clip">
          <p class="font-ral text-[24px] font-bold uppercase tracking-[1.3px] text-[#ff4f00]">{a}</p>
          <p class="font-ral text-[18px] font-medium text-white">{b}</p>
        </div>
      ))}
    </div>
    <div class="absolute left-[120px] top-[459px]"><BrowserD /></div>
  </section>

  <!-- Body -->
  <div class="absolute left-0 top-[2047px] h-[9867px] w-full overflow-clip">
    <section aria-label="At a glance" class="absolute left-0 top-[59px] flex h-[217px] w-full items-start justify-between bg-[#020202] px-[120px] py-[48px] whitespace-nowrap">
      {stats.map(([n, a, b]) => (
        <div class="flex shrink-0 flex-col items-start gap-[8px] overflow-clip">
          <p class="font-ral text-[64px] font-semibold leading-[68px] tracking-[-2px] text-white">{n}</p>
          <p class="font-ral text-[18px] font-semibold leading-[normal] text-white">{a}</p>
          <p class="font-ral text-[14px] font-normal leading-[normal] text-[#9e9ea6]">{b}</p>
        </div>
      ))}
    </section>

    <section id="overview" aria-label="Overview" class={`${sec} absolute left-0 top-[276px] h-[790px] w-full`} style="background-image:linear-gradient(4.516653272834219deg, rgb(0, 0, 0) 37.573%, rgb(255, 79, 0) 51.637%, rgb(121, 38, 0) 64.714%, rgb(0, 0, 0) 89.063%), linear-gradient(90deg, rgb(2, 2, 2) 0%, rgb(2, 2, 2) 100%)">
      <p class={eyebrow}>{'01  /  OVERVIEW'}</p>
      <h2 class={title}>OVERVIEW</h2>
      <p class={statement}>An AI automation page should sell control, not just capability.</p>
      <p class="w-[900px] font-ral text-[17px] font-normal leading-[28px] text-white">Zapier’s page has to speak to builders who want MCP and SDK access and to leaders who need governance. This concept sets out one long page that leads with a single promise, shows the product doing real work, and closes with security and scale.</p>
      <div class="flex w-[1200px] items-start gap-[24px]">
        {goals.map(([n, t, d]) => (
          <div class={`${card} h-[242px] w-[384px]`}><p class={num}>{n}</p><h3 class={ctitle}>{t}</h3><p class={ctext}>{d}</p></div>
        ))}
      </div>
    </section>

    <section aria-label="Brief and role" class={`${sec} absolute left-0 top-[1066px] h-[744px] w-full bg-[#020202]`}>
      <p class={eyebrow}>{'02  /  BRIEF AND ROLE'}</p>
      <h2 class={title}>BRIEF AND ROLE</h2>
      <p class={statement}>The brief: present Zapier’s AI platform to builders and to business leaders on one page.</p>
      <div class="flex w-[1200px] items-start gap-[24px]">
        {brief.map(([t, d]) => (
          <div class={`${card} h-[216px] w-[384px]`}><h3 class="w-full font-ral text-[22px] font-semibold leading-[30px] text-white">{t}</h3><p class="w-full font-ral text-[16px] font-normal leading-[26px] text-[#9e9ea6]">{d}</p></div>
        ))}
      </div>
      <p class="w-[900px] font-ral text-[15px] font-normal leading-[24px] text-[#9e9ea6]">This is a design case study. Product names, copy and numbers come from Zapier’s public messaging.</p>
    </section>

    <section aria-label="The page flow" class={`${sec} absolute left-0 top-[1810px] h-[1244px] w-full bg-[#020202]`}>
      <p class={eyebrow}>{'03  /  THE PAGE FLOW'}</p>
      <h2 class={title}>THE PAGE FLOW</h2>
      <p class={statement}>One long page, ordered from promise to proof to trust.</p>
      <div class="flex w-[1200px] flex-wrap items-start gap-[24px]">
        {flow.map(([lab, cw, n, ic, bg, t, d]) => (
          <div class="flex w-[588px] shrink-0 flex-col items-start gap-[16px]">
            <div class="relative flex h-[280px] w-full shrink-0 flex-col items-center justify-center overflow-clip rounded-[16px] border border-dashed border-[rgba(255,255,255,0.25)] bg-[rgba(255,255,255,0.03)]">
              <div class="absolute left-[-1px] top-[-1px] h-[280px] w-[588px] rounded-[16px]">
                <div class="pointer-events-none absolute inset-0 rounded-[16px]" style={`background:${bg}`}></div>
                <div class="absolute inset-0 overflow-hidden rounded-[16px]"><Img f={k(n)} class={`absolute max-w-none ${ic}`} sizes="588px" alt="" /></div>
              </div>
              <div class="absolute left-[5px] top-[5px] h-[21px] rounded-[5px] bg-[rgba(2,2,2,0.88)]" style={`width:${cw}px`}></div>
              <p class="absolute left-[11px] top-[10px] font-ral text-[9px] font-bold leading-[normal] tracking-[1.5px] text-[#9e9ea6] whitespace-pre">{lab}</p>
            </div>
            <h3 class="w-full font-ral text-[22px] font-semibold leading-[30px] text-white">{t}</h3>
            <p class="w-full font-ral text-[16px] font-normal leading-[26px] text-[#9e9ea6]">{d}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="principles" aria-label="Principles" class={`${sec} absolute left-0 top-[3054px] h-[730px] w-full bg-[#020202]`}>
      <p class={eyebrow}>{'04  /  PRINCIPLES'}</p>
      <h2 class={title}>PRINCIPLES</h2>
      <p class={statement}>Four rules kept a dense AI product page clear and easy to scan.</p>
      <div class="flex w-[1200px] items-start gap-[24px]">
        {principles.map(([n, t, d]) => (
          <div class={`${card} h-[298px] w-[282px]`}><p class={num}>{n}</p><h3 class={ctitle}>{t}</h3><p class={ctext}>{d}</p></div>
        ))}
      </div>
    </section>

    <section aria-label="Mobile experience" class={`${sec} absolute left-0 top-[3784px] h-[1276px] w-full`} style="background-image:linear-gradient(9.038878145065553deg, rgb(0, 0, 0) 29.532%, rgb(255, 126, 67) 43.987%, rgb(166, 51, 0) 57.428%, rgb(0, 0, 0) 82.454%), linear-gradient(7.2711152589653665deg, rgb(0, 0, 0) 37.573%, rgb(122, 145, 246) 51.604%, rgb(49, 71, 166) 64.714%, rgb(0, 0, 0) 89.063%)">
      <div class="absolute left-0 top-[2.5px] h-[1306px] w-[1440px]" style={`background-image:${stripesM}`} aria-hidden="true"></div>
      <p class={`${eyebrow} relative`}>{'05  /  MOBILE EXPERIENCE'}</p>
      <h2 class={`${title} relative`}>MOBILE EXPERIENCE</h2>
      <p class={`${statement} relative`}>The same page in one column: scroll inside the phone and switch between light and dark.</p>
      <div class="relative"><PhoneD /></div>
    </section>

    <section id="dark-mode" aria-label="Dark mode" class={`${sec} absolute left-0 top-[5060px] h-[1517px] w-full bg-[#020202]`}>
      <p class={eyebrow}>{'06  /  DARK MODE'}</p>
      <h2 class={title}>DARK MODE</h2>
      <p class={statement}>Every section has a dark twin: the same layout with different tokens.</p>
      <div class="relative h-[811px] w-[1200px] shrink-0 rounded-[16px]">
        <div class="pointer-events-none absolute inset-0 rounded-[16px] bg-[#0f0f0f]"></div>
        <div class="absolute inset-0 overflow-hidden rounded-[16px]"><Img f="ZapierCase_289-1742" class="absolute size-full max-w-none object-cover" sizes="1200px" alt="Dark mode version of the Zapier landing page hero" /></div>
        <div class="pointer-events-none absolute inset-0 rounded-[16px] border border-solid border-[rgba(255,255,255,0.12)]"></div>
      </div>
      <div class="flex w-[1200px] items-start gap-[24px]">
        {decisions.map(([n, t, d]) => (
          <div class={`${card} h-[242px] w-[384px]`}><p class={num}>{n}</p><h3 class={ctitle}>{t}</h3><p class={ctext}>{d}</p></div>
        ))}
      </div>
    </section>

    <section aria-label="Light and dark" class={`${sec} absolute left-0 top-[6577px] h-[678px] w-full`} style="background-image:linear-gradient(4.831548572993029deg, rgb(0, 0, 0) 29.532%, rgb(255, 126, 67) 43.987%, rgb(166, 51, 0) 57.428%, rgb(0, 0, 0) 82.454%), linear-gradient(2.644842937789562deg, rgb(0, 0, 0) 27.897%, rgb(122, 145, 246) 45.429%, rgb(49, 71, 166) 61.811%, rgb(0, 0, 0) 92.236%)">
      <div class="absolute left-0 top-px h-[2920px] w-[1440px]" style={`background-image:${stripes}`} aria-hidden="true"></div>
      <p class={`${eyebrow} relative`}>{'07  /  LIGHT AND DARK'}</p>
      <h2 class={`${title} relative`}>LIGHT AND DARK</h2>
      <p class={`${statement} relative`}>The same sections in both themes, side by side.</p>
      <p class="relative font-ral text-[14px] font-bold leading-[normal] tracking-[2px] text-[#f5f5f5] whitespace-pre">{'DESKTOP  /  LIGHT AND DARK'}</p>
      <div class="relative flex w-[1200px] flex-wrap content-start items-start gap-x-[24px] gap-y-[32px]">
        {wall.map(([n, dk, lab]) => (
          <div class="flex w-[282px] shrink-0 flex-col items-start gap-[10px]">
            <div class="relative h-[172px] w-[282px] shrink-0 rounded-[10px]">
              <div class="pointer-events-none absolute inset-0 rounded-[10px]" style={`background:${dk ? '#0f0f0f' : '#fffefb'}`}></div>
              <div class="absolute inset-0 overflow-hidden rounded-[10px]"><Img f={k(n)} class="absolute size-full max-w-none object-cover" sizes="282px" alt="" /></div>
              <div class="pointer-events-none absolute inset-0 rounded-[10px] border border-solid border-[rgba(255,255,255,0.12)]"></div>
            </div>
            <p class="font-ral text-[14px] font-medium leading-[normal] text-white whitespace-pre">{lab}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-label="Every section" class={`${sec} absolute left-0 top-[7255px] h-[860px] w-full bg-[#020202]`}>
      <p class={eyebrow}>{'08  /  EVERY SECTION'}</p>
      <h2 class={title}>EVERY SECTION</h2>
      <p class={statement}>From the toolkit to the closing call to action, each block has one job.</p>
      <div class="flex w-[1200px] flex-wrap content-start items-start gap-x-[24px] gap-y-[32px]">
        {photos.map(([n, dk, lab]) => (
          <div class="flex w-[282px] shrink-0 flex-col items-start gap-[10px]">
            <div class="relative h-[172px] w-[282px] shrink-0 rounded-[10px]">
              <div class="pointer-events-none absolute inset-0 rounded-[10px]" style={`background:${dk ? '#0f0f0f' : '#fffefb'}`}></div>
              <div class="absolute inset-0 overflow-hidden rounded-[10px]"><Img f={k(n)} class="absolute size-full max-w-none object-cover" sizes="282px" alt="" /></div>
              <div class="pointer-events-none absolute inset-0 rounded-[10px] border border-solid border-[rgba(255,255,255,0.12)]"></div>
            </div>
            <p class="font-ral text-[14px] font-medium leading-[normal] text-white whitespace-nowrap">{lab}</p>
          </div>
        ))}
        <div class="flex w-[282px] shrink-0 flex-col items-start gap-[10px]">
          <div class="relative h-[172px] w-[282px] shrink-0 rounded-[10px]">
            <div class="pointer-events-none absolute inset-0 rounded-[10px] bg-[#0f0f0f]"></div>
            <Img f="ZapierCase_289-2961" class="absolute size-full max-w-none rounded-[10px] object-contain" sizes="282px" alt="" />
            <div class="pointer-events-none absolute inset-0 rounded-[10px] border border-solid border-[rgba(255,255,255,0.12)]"></div>
          </div>
          <p class="font-ral text-[14px] font-medium leading-[normal] text-white whitespace-nowrap">Closing CTA</p>
        </div>
      </div>
    </section>

    <section aria-label="Brand style" class={`${sec} absolute left-0 top-[8115px] h-[938px] w-full`} style="background-image:linear-gradient(6.669949668571263deg, rgb(0, 0, 0) 29.532%, rgb(255, 126, 67) 43.987%, rgb(166, 51, 0) 57.428%, rgb(0, 0, 0) 82.454%), linear-gradient(3.656717737717244deg, rgb(0, 0, 0) 27.897%, rgb(122, 145, 246) 45.429%, rgb(49, 71, 166) 61.811%, rgb(0, 0, 0) 92.236%)">
      <div class="absolute left-0 top-[0.5px] h-[2146px] w-[1440px]" style={`background-image:${stripes}`} aria-hidden="true"></div>
      <p class={`${eyebrow} relative`}>{'09  /  BRAND STYLE'}</p>
      <h2 class={`${title} relative`}>BRAND STYLE</h2>
