---
import Base from '../layouts/Base.astro';
import Desktop from '../components/boltshift/Desktop.astro';
import Tablet from '../components/boltshift/Tablet.astro';
import Mobile from '../components/boltshift/Mobile.astro';
import FloatingBar from '../components/FloatingBar.astro';
---
<Base title="BoltShift — Mehroze Maqsood">
  <main class="stage stage-d mx-auto"><Desktop /><FloatingBar v="d" /></main>
  <main class="stage stage-t mx-auto"><Tablet /><FloatingBar v="t" /></main>
  <main class="stage stage-m mx-auto"><Mobile /><FloatingBar v="m" /></main>
</Base>
