---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '@fontsource/raleway/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '../styles/global.css';
const { title = 'Mehroze Maqsood — UI/UX & Product Designer', description = 'UI/UX and product designer portfolio.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preload" href="/fonts/Utara-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
<script is:inline>
// scale the active Figma frame (1440 / 768 / 390) to the viewport width, before first paint
(function(){var w=document.documentElement.clientWidth,d=w>=1024?1440:w>=600?768:390;
document.documentElement.style.setProperty('--z',(w/d)+'');
addEventListener('resize',function(){var w=document.documentElement.clientWidth,d=w>=1024?1440:w>=600?768:390;document.documentElement.style.setProperty('--z',(w/d)+'')})})();
</script>
<Analytics />
<SpeedInsights />
</head>
<body><slot /><script>import '../scripts/motion.js';</script></body>
</html>
