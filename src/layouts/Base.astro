---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '@fontsource/raleway/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '../styles/global.css';
const { title = 'Mehroze Maqsood', description = 'UI/UX and product designer portfolio.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preload" href="/fonts/Utara-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
<script is:inline src="/scale.js"></script>
<Analytics />
<SpeedInsights />
<link rel="icon" href="/favicon.ico?v=4" sizes="48x48" />
<link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png?v=4" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
</head>
<body><slot /><script>import '../scripts/protect.js';import '../scripts/motion.js';</script></body>
</html>
